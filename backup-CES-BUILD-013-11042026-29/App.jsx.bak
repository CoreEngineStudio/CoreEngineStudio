const steps = [
  "Kostenloser Erstkontakt",
  "Ziel und Richtung klären",
  "Konzept und Designbasis erstellen",
  "Umsetzung mit sauberer Struktur",
  "Test, Feinschliff und Onlinegang",
  "Betreuung und Erweiterung auf Wunsch",
];

function App() {
  const [toneIndex, setToneIndex] = useState(0);
  const activeTone = colorPhases[toneIndex];

  useEffect(() => {
    const timer = window.setInterval(() => {
      setToneIndex((current) => (current + 1) % colorPhases.length);
    }, 12000);

    return () => window.clearInterval(timer);
  }, []);

  return (
    <main className={`app-shell tone-${activeTone}`}>
      <MatrixRain tone={activeTone} />
      <div className="engine-grid" />
      <div className="soft-scanlines" />
      <div className="ambient ambient-green" />
      <div className="ambient ambient-red" />
      <div className="ambient ambient-cyan" />

      <header className="site-header">
        <a className="brand" href="#start" aria-label="CoreEngineStudio Start">
          <img src={logoIcon} alt="" />
          <span className="brand-text">
            <strong>CoreEngineStudio</strong>
            <small>Digital Studio</small>
          </span>
        </a>

        <nav className="main-nav" aria-label="Hauptnavigation">
          <a href="#leistungen">Leistungen</a>
          <a href="#showroom">Showroom</a>
          <a href="#referenzen">Referenzen</a>
          <a href="#ablauf">Ablauf</a>
          <a href="#kontakt">Kontakt</a>
        </nav>
      </header>

      <section id="start" className="hero-section full-bleed-section">
        <motion.div
          className="hero-copy premium-hero-copy"
          initial={{ opacity: 0, y: 18 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.55, ease: "easeOut" }}
        >
          <div className="eyebrow">
            <Sparkles size={16} />
            Hero Width · Build 012
          </div>

          <div className="hero-brandline">
            <span>CoreEngineStudio</span>
            <strong>Digital Studio für Webseiten, Systeme & Automatisierung</strong>
          </div>

          <h1>
            Digitale Auftritte
            <span>mit smarter Engine.</span>
          </h1>

          <p className="hero-lead">
            CoreEngineStudio verbindet hochwertige Gestaltung mit klarer Technik:
            Webseiten, Portale, Anfrageflows, Datenbanken und Automatisierung
            aus einer starken digitalen Basis.
          </p>

          <div className="hero-actions">
            <a className="primary-action" href="#showroom">
              CoreCube starten
              <ArrowRight size={18} />
            </a>
            <a className="secondary-action" href="#leistungen">
              Leistungen ansehen
            </a>
            <a className="ghost-action" href="#kontakt">
              Projekt anfragen
            </a>
          </div>

          <div className="hero-module-strip" aria-label="CoreEngineStudio Schwerpunkte">
            <article>
              <span>01</span>
              <strong>Webseiten</strong>
              <small>Auftritt, Landingpage, Firmenwebsite</small>
            </article>
            <article>
              <span>02</span>
              <strong>Systeme</strong>
              <small>Portale, Dashboards, Datenbanken</small>
            </article>
            <article>
              <span>03</span>
              <strong>Automation</strong>
              <small>Anfragen, Statusmails, Abläufe</small>
            </article>
          </div>
        </motion.div>

<motion.div
          className="hero-engine-stage"
          initial={{ opacity: 0, x: 24, scale: 0.96 }}
          animate={{ opacity: 1, x: 0, scale: 1 }}
          transition={{ duration: 0.75, delay: 0.12, ease: "easeOut" }}
          aria-label="CoreEngineStudio Engine Visual"
        >
          <div className="hero-orbit orbit-one" />
          <div className="hero-orbit orbit-two" />

          <ShowcaseCube
            size={360}
            rotationMode="tour"
            className="hero-showcase-cube"
          />
        </motion.div>
      </section>

      <section id="leistungen" className="section-block full-bleed-section">
        <div className="section-heading wide-heading">
          <span>Leistungen</span>
          <h2>Mehr als eine Website.</h2>
          <p>
            CoreEngineStudio verbindet sichtbaren Auftritt mit funktionierender
            Struktur: Design, Systeme, Automatisierung und Betreuung aus einer
            klaren Engine.
          </p>
        </div>

        <div className="service-grid">
          {services.map((service, index) => {
            const Icon = service.icon;
            return (
              <motion.article
                className="service-card"
                key={service.title}
                initial={{ opacity: 0, y: 14 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true, amount: 0.25 }}
                transition={{ duration: 0.38, delay: index * 0.035 }}
              >
                <div className="card-icon">
                  <Icon size={22} />
                </div>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
              </motion.article>
            );
          })}
        </div>
      </section>

      <section id="showroom" className="showroom-section full-bleed-section">
        <div className="showroom-copy">
          <span>CoreHub Vision</span>
          <h2>Der Showroom wird zur Beratung.</h2>
          <p>
            Langfristig zeigt der CoreHub mehrere Cubes für Webseiten, Systeme,
            Portale, Tools, Automatisierung und Design. Version 1 fokussiert
            den Webseiten-Cube.
          </p>
          <p className="showroom-note">
            Die Demo-Welten sind Showcases. Farben, Aufbau, Inhalte und
            Funktionen werden später individuell an jedes Projekt angepasst.
          </p>
        </div>

        <div className="hub-preview" aria-label="CoreHub Vorschau">
          {hubCubes.map((cube, index) => (
            <article className={`hub-card ${cube.active ? "active" : ""}`} key={cube.title}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{cube.title}</h3>
              <p>{cube.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section className="section-block full-bleed-section">
        <div className="section-heading wide-heading">
          <span>Webseiten-Cube · Version 1</span>
          <h2>Sechs Richtungen. Ein klarer Einstieg.</h2>
          <p>
            Der Webseiten-Cube führt Besucher nicht über Fachbegriffe, sondern
            über Nutzen: seriös auftreten, hochwertig wirken, verkaufen,
            buchen, Community aufbauen oder Abläufe digitalisieren.
          </p>
        </div>

        <div className="theme-grid">
          {cubeThemes.map((theme, index) => {
            const Icon = theme.icon;
            return (
              <motion.article
                className="theme-card"
                key={theme.title}
                initial={{ opacity: 0, y: 14 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true, amount: 0.2 }}
                transition={{ duration: 0.38, delay: index * 0.035 }}
              >
                <div className="theme-head">
                  <div className="theme-icon">
                    <Icon size={20} />
                  </div>
                  <span>{theme.tone}</span>
                </div>
                <h3>{theme.title}</h3>
                <strong>{theme.label}</strong>
                <p>{theme.text}</p>
              </motion.article>
            );
          })}
        </div>
      </section>

      <section id="referenzen" className="reference-section full-bleed-section">
        <div>
          <span>Referenzen</span>
          <h2>Erste echte Projektbasis ist vorhanden.</h2>
        </div>

        <div className="reference-grid">
          <article>
            <h3>All4You Service München</h3>
            <p>
              Dienstleister-Website mit Anfrage-Wizards, Supabase-Anfragen,
              Ticketnummern, Statuslogik und Portal-/Dashboard-Konzept.
            </p>
          </article>
          <article>
            <h3>Hammer Modding</h3>
            <p>
              Produktseiten, Shop-/Katalogstruktur, Admin-Ideen,
              Discord-/Tebex-Konzept und modernes Dark-Design.
            </p>
          </article>
        </div>
      </section>

      <section id="ablauf" className="section-block compact full-bleed-section">
        <div className="section-heading wide-heading">
          <span>Ablauf</span>
          <h2>Vom ersten Gespräch bis zur fertigen Engine.</h2>
          <p>
            Der Erstkontakt ist kostenlos. Danach wird Schritt für Schritt
            geklärt, was gebraucht wird und welche Lösung wirklich Sinn macht.
          </p>
        </div>

        <div className="steps-list">
          {steps.map((step, index) => (
            <div className="step-item" key={step}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{step}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="kontakt" className="contact-section full-bleed-section">
        <div>
          <span>Projekt anfragen</span>
          <h2>Bereit für den nächsten digitalen Schritt?</h2>
          <p>
            Für den Anfang reicht eine kurze Nachricht. Der Anfrageassistent
            wird später als eigene smarte Engine ausgebaut.
          </p>
        </div>

        <a className="primary-action" href="mailto:info@coreenginestudio.de">
          <Mail size={18} />
          info@coreenginestudio.de
        </a>
      </section>

      <footer className="site-footer full-bleed-section">
        <span>CoreEngineStudio</span>
        <span>{BUILD_ID}</span>
      </footer>
    </main>
  );
}

export default App;
