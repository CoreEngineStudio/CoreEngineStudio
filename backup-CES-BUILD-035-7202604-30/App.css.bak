#root {
  min-height: 100vh;
}

:root {
  --bg: #020402;
  --bg-soft: #061006;
  --panel: rgba(7, 15, 8, 0.76);
  --panel-strong: rgba(8, 18, 9, 0.92);
  --line: rgba(113, 255, 23, 0.18);
  --line-strong: rgba(113, 255, 23, 0.42);
  --text: #f5fff0;
  --muted: #a6b5a0;
  --green: #76ff16;
  --green-soft: #b8ff7a;
  --green-deep: #245f0e;
  --cyan: #41d9ff;
  --red: #ff453a;
  --shadow: 0 30px 100px rgba(0, 0, 0, 0.58);
}

.app-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: var(--text);
  background:
    radial-gradient(circle at 18% 13%, rgba(255, 69, 58, 0.14), transparent 32rem),
    radial-gradient(circle at 83% 17%, rgba(65, 217, 255, 0.11), transparent 30rem),
    radial-gradient(circle at 44% 10%, rgba(118, 255, 22, 0.17), transparent 42rem),
    linear-gradient(135deg, #010201 0%, #071007 48%, #020302 100%);
}

.full-bleed-section,
.site-header {
  width: 100%;
  padding-left: clamp(1rem, 3.3vw, 4rem);
  padding-right: clamp(1rem, 3.3vw, 4rem);
}

.engine-grid {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.26;
  background-image:
    linear-gradient(rgba(118, 255, 22, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(118, 255, 22, 0.08) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(circle at center, #000 0%, transparent 82%);
}

.soft-scanlines {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.16;
  background: repeating-linear-gradient(
    180deg,
    transparent 0,
    transparent 7px,
    rgba(118, 255, 22, 0.05) 8px
  );
}

.ambient {
  position: fixed;
  pointer-events: none;
  filter: blur(42px);
  opacity: 0.72;
}

.ambient-green {
  width: 30rem;
  height: 30rem;
  left: 37%;
  top: -13rem;
  background: rgba(118, 255, 22, 0.19);
}

.ambient-red {
  width: 22rem;
  height: 22rem;
  left: -9rem;
  top: 12rem;
  background: rgba(255, 69, 58, 0.14);
}

.ambient-cyan {
  width: 24rem;
  height: 24rem;
  right: -9rem;
  top: 9rem;
  background: rgba(65, 217, 255, 0.12);
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding-top: 0.78rem;
  padding-bottom: 0.78rem;
  background: linear-gradient(180deg, rgba(2, 4, 2, 0.86), rgba(2, 4, 2, 0.33));
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(118, 255, 22, 0.1);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--text);
  text-decoration: none;
}

.brand img {
  width: 3.4rem;
  height: 3.4rem;
  object-fit: contain;
  filter: drop-shadow(0 0 18px rgba(118, 255, 22, 0.34));
}

.brand-text {
  display: grid;
  gap: 0.08rem;
}

.brand-text strong {
  font-size: 1rem;
  letter-spacing: -0.025em;
}

.brand-text small {
  color: var(--muted);
  font-size: 0.74rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.35rem;
  border: 1px solid rgba(118, 255, 22, 0.13);
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.34);
}

.main-nav a {
  color: var(--muted);
  text-decoration: none;
  font-size: 0.88rem;
  padding: 0.68rem 0.9rem;
  border-radius: 999px;
  transition: 180ms ease;
}

.main-nav a:hover {
  color: var(--text);
  background: rgba(118, 255, 22, 0.1);
}

.hero-section {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: minmax(34rem, 0.78fr) minmax(30rem, 1.22fr);
  gap: clamp(2rem, 4vw, 5rem);
  align-items: center;
  min-height: calc(100vh - 70px);
  padding-top: clamp(3rem, 5vw, 6rem);
  padding-bottom: clamp(3rem, 5vw, 6rem);
}

.eyebrow,
.section-heading span,
.showroom-copy span,
.reference-section span,
.contact-section span {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  width: fit-content;
  border: 1px solid rgba(118, 255, 22, 0.25);
  border-radius: 999px;
  padding: 0.5rem 0.78rem;
  color: var(--green);
  background: rgba(118, 255, 22, 0.1);
  box-shadow: inset 0 0 18px rgba(118, 255, 22, 0.08);
  font-size: 0.82rem;
  font-weight: 900;
  letter-spacing: -0.01em;
}

.hero-copy h1 {
  margin: 1.3rem 0 1.2rem;
  max-width: 780px;
  font-size: clamp(4rem, 7.45vw, 9.3rem);
  line-height: 0.875;
  letter-spacing: -0.09em;
}

.hero-copy h1 span {
  display: block;
  color: transparent;
  background: linear-gradient(90deg, #f5fff0, var(--green-soft), var(--green));
  -webkit-background-clip: text;
  background-clip: text;
  filter: drop-shadow(0 0 20px rgba(118, 255, 22, 0.15));
}

.hero-lead {
  max-width: 720px;
  margin: 0;
  color: #d9e7d3;
  font-size: clamp(1rem, 1.5vw, 1.24rem);
  line-height: 1.8;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  margin-top: 2rem;
}

.primary-action,
.secondary-action,
.ghost-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  min-height: 3.15rem;
  border-radius: 999px;
  padding: 0 1.2rem;
  font-weight: 900;
  text-decoration: none;
  transition: 180ms ease;
}

.primary-action {
  border: 1px solid rgba(184, 255, 122, 0.5);
  color: #061006;
  background: linear-gradient(135deg, var(--green-soft), var(--green));
  box-shadow: 0 18px 45px rgba(118, 255, 22, 0.22);
}

.primary-action:hover {
  transform: translateY(-2px);
  box-shadow: 0 22px 60px rgba(118, 255, 22, 0.33);
}

.secondary-action {
  border: 1px solid rgba(118, 255, 22, 0.36);
  color: var(--text);
  background: rgba(118, 255, 22, 0.08);
}

.secondary-action:hover,
.ghost-action:hover {
  transform: translateY(-2px);
  border-color: rgba(184, 255, 122, 0.5);
  background: rgba(118, 255, 22, 0.12);
}

.ghost-action {
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--muted);
  background: rgba(255, 255, 255, 0.03);
}

.hero-notes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  margin-top: 2rem;
  color: var(--muted);
  font-size: 0.9rem;
}

.hero-notes span {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.hero-notes svg {
  color: var(--green);
}

.hero-engine-stage {
  position: relative;
  min-height: 50rem;
  display: grid;
  place-items: center;
  isolation: isolate;
}

.hero-engine-stage::before {
  content: none;
}

.hero-orbit {
  display: none;
}

.core-logo-card {
  position: relative;
  display: grid;
  width: min(30vw, 29rem);
  min-width: 20rem;
  aspect-ratio: 1;
  place-items: center;
  border-radius: 2rem;
}

.core-logo-glow {
  position: absolute;
  width: 74%;
  height: 74%;
  border-radius: 50%;
  background: rgba(118, 255, 22, 0.24);
  filter: blur(46px);
}

.core-logo-card img {
  position: relative;
  z-index: 2;
  width: 100%;
  object-fit: contain;
  filter: drop-shadow(0 0 42px rgba(118, 255, 22, 0.36));
}

.command-panel,
.engine-module,
.launch-line {
  position: absolute;
  border: 1px solid rgba(118, 255, 22, 0.16);
  background: rgba(2, 8, 3, 0.76);
  backdrop-filter: blur(18px);
  box-shadow: 0 20px 70px rgba(0, 0, 0, 0.36);
}

.panel-main {
  left: 2%;
  top: 16%;
  width: 19.5rem;
  border-radius: 1.4rem;
  padding: 1.15rem;
}

.panel-kicker {
  display: block;
  color: var(--green);
  font-size: 0.75rem;
  font-weight: 900;
  letter-spacing: 0.08em;
  margin-bottom: 0.7rem;
}

.command-panel strong {
  display: block;
  color: var(--text);
  font-size: 1.2rem;
  margin-bottom: 0.45rem;
}

.command-panel p {
  margin: 0;
  color: var(--muted);
  line-height: 1.55;
  font-size: 0.92rem;
}

.engine-module {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  min-width: 12.3rem;
  border-radius: 1.1rem;
  padding: 0.85rem;
}

.engine-module svg,
.launch-line svg {
  color: var(--green);
}

.engine-module strong {
  display: block;
  font-size: 0.92rem;
}

.engine-module span {
  display: block;
  color: var(--muted);
  font-size: 0.78rem;
  margin-top: 0.12rem;
}

.module-1 {
  right: 5%;
  top: 18%;
}

.module-2 {
  left: 4%;
  bottom: 24%;
}

.module-3 {
  right: 2%;
  bottom: 28%;
}

.module-4 {
  right: 20%;
  bottom: 8%;
}

.launch-line {
  left: 50%;
  bottom: 3%;
  transform: translateX(-50%);
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  border-radius: 999px;
  padding: 0.78rem 1rem;
  color: var(--text);
  font-weight: 800;
}

.section-block,
.showroom-section,
.reference-section,
.contact-section {
  position: relative;
  z-index: 2;
  margin: 0 auto;
  padding-top: clamp(4rem, 6vw, 7rem);
  padding-bottom: clamp(4rem, 6vw, 7rem);
  border-top: 1px solid rgba(118, 255, 22, 0.08);
}

.section-heading {
  max-width: 880px;
  margin-bottom: 2rem;
}

.wide-heading {
  max-width: 1050px;
}

.section-heading h2,
.showroom-copy h2,
.reference-section h2,
.contact-section h2 {
  margin: 1rem 0 0.7rem;
  color: var(--text);
  font-size: clamp(2.4rem, 4.8vw, 5.2rem);
  line-height: 0.96;
  letter-spacing: -0.07em;
}

.section-heading p,
.showroom-copy p,
.reference-section p,
.contact-section p {
  margin: 0;
  color: var(--muted);
  font-size: 1.03rem;
  line-height: 1.75;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 1rem;
}

.service-card,
.theme-card,
.reference-grid article,
.hub-card,
.step-item {
  border: 1px solid rgba(118, 255, 22, 0.13);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent),
    var(--panel);
  box-shadow: var(--shadow);
  backdrop-filter: blur(18px);
}

.service-card {
  min-height: 15rem;
  border-radius: 1.45rem;
  padding: 1.25rem;
}

.card-icon,
.theme-icon {
  display: grid;
  place-items: center;
  width: 2.65rem;
  height: 2.65rem;
  border: 1px solid rgba(118, 255, 22, 0.25);
  border-radius: 0.9rem;
  color: var(--green);
  background: rgba(118, 255, 22, 0.08);
}

.service-card h3,
.theme-card h3,
.reference-grid h3,
.hub-card h3 {
  margin: 1.2rem 0 0.55rem;
  font-size: 1.08rem;
}

.service-card p,
.theme-card p,
.reference-grid p,
.hub-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.65;
  font-size: 0.95rem;
}

.showroom-section {
  display: grid;
  grid-template-columns: minmax(0, 0.68fr) minmax(420px, 1.32fr);
  gap: 2rem;
  align-items: center;
  min-height: 46rem;
  background:
    radial-gradient(circle at 71% 45%, rgba(118, 255, 22, 0.16), transparent 34rem),
    rgba(255, 255, 255, 0.012);
}

.showroom-note {
  margin-top: 1rem !important;
  border-left: 2px solid var(--green);
  padding-left: 1rem;
}

.hub-preview {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  perspective: 1000px;
}

.hub-card {
  min-height: 11rem;
  border-radius: 1.35rem;
  padding: 1.1rem;
  transform: translateZ(0);
  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
}

.hub-card:hover {
  transform: translateY(-4px);
  border-color: rgba(118, 255, 22, 0.32);
  background:
    radial-gradient(circle at 45% 0%, rgba(118, 255, 22, 0.14), transparent 12rem),
    var(--panel);
}

.hub-card.active {
  border-color: rgba(118, 255, 22, 0.42);
  box-shadow: 0 25px 95px rgba(118, 255, 22, 0.12);
}

.hub-card span {
  color: var(--green);
  font-weight: 900;
  font-size: 0.78rem;
}

.hub-card h3 {
  font-size: 1.45rem;
  letter-spacing: -0.04em;
}

.theme-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.theme-card {
  border-radius: 1.45rem;
  padding: 1.2rem;
}

.theme-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.theme-head span {
  color: var(--muted);
  font-size: 0.75rem;
  text-align: right;
}

.theme-card strong {
  display: block;
  margin-bottom: 0.7rem;
  color: var(--green);
  font-size: 0.92rem;
}

.reference-section {
  display: grid;
  grid-template-columns: minmax(0, 0.66fr) minmax(0, 1.34fr);
  gap: 2rem;
  align-items: start;
}

.reference-grid {
  display: grid;
  gap: 1rem;
}

.reference-grid article {
  border-radius: 1.35rem;
  padding: 1.35rem;
}

.compact {
  padding-bottom: 4rem;
}

.steps-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.step-item {
  display: flex;
  gap: 1rem;
  align-items: center;
  border-radius: 1.2rem;
  padding: 1rem;
}

.step-item span {
  color: var(--green);
  font-weight: 900;
  font-size: 0.9rem;
}

.step-item p {
  margin: 0;
  color: #e7f4e1;
}

.contact-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  background:
    radial-gradient(circle at 14% 22%, rgba(118, 255, 22, 0.13), transparent 26rem),
    rgba(255, 255, 255, 0.016);
}

.site-footer {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin: 0 auto;
  padding-top: 2rem;
  padding-bottom: 2.4rem;
  color: var(--muted);
  font-size: 0.86rem;
  border-top: 1px solid rgba(118, 255, 22, 0.08);
}

@media (max-width: 1180px) {
  .hero-section,
  .showroom-section,
  .reference-section {
    grid-template-columns: 1fr;
  }

  .hero-copy h1 {
    max-width: 980px;
  }

  .hero-engine-stage {
    min-height: 36rem;
  }

  .service-grid,
  .theme-grid,
  .steps-list,
  .hub-preview {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .panel-main,
  .module-1,
  .module-2,
  .module-3,
  .module-4,
  .launch-line {
    position: static;
    transform: none;
  }

  .hero-engine-stage {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, auto));
    gap: 1rem;
  }

  .core-logo-card {
    grid-column: 1 / -1;
    justify-self: center;
  }
}

@media (max-width: 760px) {
  .main-nav {
    display: none;
  }

  .hero-section {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .hero-copy h1 {
    font-size: clamp(3.4rem, 16vw, 6.5rem);
  }

  .service-grid,
  .theme-grid,
  .steps-list,
  .hub-preview {
    grid-template-columns: 1fr;
  }

  .hero-engine-stage {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .core-logo-card {
    min-width: 16rem;
    width: min(78vw, 24rem);
  }

  .contact-section,
  .site-footer {
    flex-direction: column;
    align-items: stretch;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}


/* CES-BUILD-004: ShowcaseCube v2 integration */
.hero-showcase-cube {
  position: relative;
  z-index: 3;
  width: min(100%, 42rem);
  --cube-size: 360px;
  filter: drop-shadow(0 0 26px rgba(118, 255, 22, 0.16));
}

.hero-showcase-cube .showcase-cube {
  will-change: transform;
}

.hero-showcase-cube .showcase-cube-face {
  border-radius: 26px;
}

.hero-showcase-cube .face-screen {
  backdrop-filter: blur(10px);
}

@media (max-width: 1180px) {
  .hero-showcase-cube {
    grid-column: 1 / -1;
    justify-self: center;
    --cube-size: 320px;
  }
}

@media (max-width: 760px) {
  .hero-showcase-cube {
    --cube-size: 235px;
  }
}


/* CES-BUILD-005: Matrix background + Core orbit planets */
.matrix-rain-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0.23;
  mix-blend-mode: screen;
  mask-image:
    radial-gradient(circle at 74% 42%, #000 0%, rgba(0, 0, 0, 0.72) 28%, transparent 68%),
    linear-gradient(180deg, rgba(0,0,0,0.78), transparent 88%);
}

.core-orbit-system {
  position: absolute;
  inset: 0;
  z-index: 6;
  pointer-events: none;
  transform-style: preserve-3d;
}

.orbit-track {
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--orbit-w);
  height: var(--orbit-h);
  margin-left: calc(var(--orbit-w) / -2);
  margin-top: calc(var(--orbit-h) / -2);
  border: 1px solid rgba(118, 255, 22, 0.065);
  border-radius: 50%;
  transform: rotate(var(--orbit-tilt));
  animation: orbit-spin var(--orbit-speed) linear infinite;
  will-change: transform;
  pointer-events: none;
}

.orbit-track::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  border: 1px solid rgba(118, 255, 22, 0.035);
  filter: blur(0.5px);
}

.orbit-a {
  --orbit-w: min(50vw, 42rem);
  --orbit-h: min(25vw, 21rem);
  --orbit-speed: 28s;
  --orbit-tilt: -12deg;
}

.orbit-b {
  --orbit-w: min(56vw, 47rem);
  --orbit-h: min(31vw, 26rem);
  --orbit-speed: 38s;
  --orbit-tilt: 18deg;
  animation-direction: reverse;
}

.orbit-c {
  --orbit-w: min(45vw, 37rem);
  --orbit-h: min(34vw, 29rem);
  --orbit-speed: 33s;
  --orbit-tilt: 61deg;
}

.orbit-d {
  --orbit-w: min(60vw, 50rem);
  --orbit-h: min(25vw, 21rem);
  --orbit-speed: 45s;
  --orbit-tilt: -32deg;
  animation-direction: reverse;
}

.orbit-e {
  --orbit-w: min(39vw, 32rem);
  --orbit-h: min(39vw, 32rem);
  --orbit-speed: 24s;
  --orbit-tilt: 36deg;
}

.orbit-f {
  --orbit-w: min(57vw, 48rem);
  --orbit-h: min(42vw, 35rem);
  --orbit-speed: 52s;
  --orbit-tilt: -55deg;
  animation-direction: reverse;
}

.orbit-planet {
  position: absolute;
  left: calc(50% - var(--planet-size) / 2);
  top: calc(var(--planet-size) / -2);
  display: grid;
  place-items: center;
  width: var(--planet-size);
  height: var(--planet-size);
  border: 0;
  padding: 0;
  border-radius: 999px;
  background: transparent;
  cursor: pointer;
  pointer-events: auto;
  animation: planet-counter var(--orbit-speed) linear infinite;
  will-change: transform;
}

.orbit-b .orbit-planet,
.orbit-d .orbit-planet,
.orbit-f .orbit-planet {
  animation-direction: reverse;
}

.planet-surface {
  position: relative;
  display: grid;
  place-items: center;
  width: var(--planet-size);
  height: var(--planet-size);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 999px;
  color: rgba(255, 255, 255, 0.92);
  background:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.9), transparent 7%),
    radial-gradient(circle at 34% 30%, var(--planet-light), transparent 16%),
    radial-gradient(circle at 63% 70%, rgba(0, 0, 0, 0.55), transparent 44%),
    radial-gradient(circle at 42% 38%, var(--planet-main), var(--planet-dark) 72%);
  box-shadow:
    inset -10px -12px 18px rgba(0, 0, 0, 0.42),
    inset 8px 8px 18px rgba(255, 255, 255, 0.12),
    0 0 24px var(--planet-glow),
    0 0 58px rgba(118, 255, 22, 0.08);
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;
}

.planet-surface::before {
  content: "";
  position: absolute;
  inset: 9%;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(255,255,255,0.35), transparent 38%);
  opacity: 0.65;
}

.planet-surface svg {
  position: relative;
  z-index: 2;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));
}

.orbit-planet:hover .planet-surface {
  transform: scale(1.16);
  border-color: rgba(255, 255, 255, 0.36);
  box-shadow:
    inset -10px -12px 18px rgba(0, 0, 0, 0.42),
    inset 8px 8px 18px rgba(255, 255, 255, 0.14),
    0 0 34px var(--planet-glow),
    0 0 90px var(--planet-glow);
}

.planet-tooltip {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 0.75rem);
  width: max-content;
  max-width: 13rem;
  transform: translateX(-50%) translateY(8px);
  border: 1px solid rgba(118, 255, 22, 0.18);
  border-radius: 0.9rem;
  padding: 0.65rem 0.75rem;
  color: var(--text);
  background: rgba(2, 8, 3, 0.92);
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.42);
  opacity: 0;
  visibility: hidden;
  transition: 160ms ease;
  backdrop-filter: blur(16px);
  text-align: center;
}

.planet-tooltip strong {
  display: block;
  font-size: 0.86rem;
}

.planet-tooltip small {
  display: block;
  margin-top: 0.22rem;
  color: var(--muted);
  font-size: 0.72rem;
  line-height: 1.35;
}

.orbit-planet:hover .planet-tooltip {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

.planet-green {
  --planet-size: 3.15rem;
  --planet-main: #76ff16;
  --planet-dark: #185e08;
  --planet-light: #dbffb8;
  --planet-glow: rgba(118, 255, 22, 0.55);
}

.planet-cyan {
  --planet-size: 2.75rem;
  --planet-main: #40d9ff;
  --planet-dark: #08516a;
  --planet-light: #d6f7ff;
  --planet-glow: rgba(64, 217, 255, 0.44);
}

.planet-violet {
  --planet-size: 2.95rem;
  --planet-main: #8b5cff;
  --planet-dark: #29146e;
  --planet-light: #e0d5ff;
  --planet-glow: rgba(139, 92, 255, 0.45);
}

.planet-orange {
  --planet-size: 3rem;
  --planet-main: #ff9c32;
  --planet-dark: #853400;
  --planet-light: #ffe0b3;
  --planet-glow: rgba(255, 156, 50, 0.44);
}

.planet-silver {
  --planet-size: 2.55rem;
  --planet-main: #e7f2df;
  --planet-dark: #5f6d59;
  --planet-light: #ffffff;
  --planet-glow: rgba(231, 242, 223, 0.32);
}

.planet-red {
  --planet-size: 2.85rem;
  --planet-main: #ff453a;
  --planet-dark: #73100c;
  --planet-light: #ffd3d0;
  --planet-glow: rgba(255, 69, 58, 0.4);
}

.hero-showcase-cube {
  z-index: 4;
}

@keyframes orbit-spin {
  from {
    transform: rotate(var(--orbit-tilt)) rotate(0deg);
  }
  to {
    transform: rotate(var(--orbit-tilt)) rotate(360deg);
  }
}

@keyframes planet-counter {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(-360deg);
  }
}

.hero-engine-stage:hover .orbit-track {
  animation-play-state: paused;
}

.hero-engine-stage:hover .orbit-planet {
  animation-play-state: paused;
}

@media (max-width: 1180px) {
  .core-orbit-system {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .matrix-rain-canvas {
    display: none;
  }

  .orbit-track,
  .orbit-planet {
    animation: none !important;
  }
}


/* CES-BUILD-006: Free Orbit Hero Cleanup */
.hero-engine-stage {
  overflow: visible;
}

.hero-engine-stage::after {
  content: "";
  position: absolute;
  inset: 8% 3% 4%;
  z-index: -3;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 48%, rgba(118, 255, 22, 0.11), transparent 20rem),
    radial-gradient(circle at 64% 54%, rgba(65, 217, 255, 0.06), transparent 22rem);
  filter: blur(2px);
}

.core-orbit-system {
  overflow: visible;
}

/* Die kleinen Bahnen bleiben, aber der störende große Außenkreis aus den alten Hero-Orbits ist entfernt. */


/* CES-BUILD-007: Core Color Pulse */
.app-shell {
  --pulse-main: var(--green);
  --pulse-soft: var(--green-soft);
  --pulse-rgb: 118, 255, 22;
  --pulse-glow: rgba(var(--pulse-rgb), 0.28);
  transition:
    background 2.8s ease,
    color 2.8s ease;
}

.app-shell.tone-green {
  --green: #76ff16;
  --green-soft: #b8ff7a;
  --pulse-main: #76ff16;
  --pulse-soft: #b8ff7a;
  --pulse-rgb: 118, 255, 22;
  --pulse-glow: rgba(118, 255, 22, 0.3);
}

.app-shell.tone-cyan {
  --green: #41d9ff;
  --green-soft: #bff4ff;
  --pulse-main: #41d9ff;
  --pulse-soft: #bff4ff;
  --pulse-rgb: 65, 217, 255;
  --pulse-glow: rgba(65, 217, 255, 0.3);
}

.app-shell.tone-purple {
  --green: #b05cff;
  --green-soft: #dfc2ff;
  --pulse-main: #b05cff;
  --pulse-soft: #dfc2ff;
  --pulse-rgb: 176, 92, 255;
  --pulse-glow: rgba(176, 92, 255, 0.28);
}

.app-shell.tone-red {
  --green: #ff453a;
  --green-soft: #ffb1aa;
  --pulse-main: #ff453a;
  --pulse-soft: #ffb1aa;
  --pulse-rgb: 255, 69, 58;
  --pulse-glow: rgba(255, 69, 58, 0.28);
}

.app-shell.tone-green,
.app-shell.tone-cyan,
.app-shell.tone-purple,
.app-shell.tone-red {
  background:
    radial-gradient(circle at 18% 13%, rgba(255, 69, 58, 0.11), transparent 32rem),
    radial-gradient(circle at 83% 17%, rgba(65, 217, 255, 0.1), transparent 30rem),
    radial-gradient(circle at 44% 10%, var(--pulse-glow), transparent 42rem),
    linear-gradient(135deg, #010201 0%, #071007 48%, #020302 100%);
}

.engine-grid {
  transition: opacity 2.8s ease, background-image 2.8s ease;
  background-image:
    linear-gradient(rgba(var(--pulse-rgb), 0.075) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--pulse-rgb), 0.075) 1px, transparent 1px);
}

.site-header {
  transition: border-color 2.8s ease, background 2.8s ease;
  border-bottom-color: rgba(var(--pulse-rgb), 0.12);
}

.brand img {
  transition: filter 2.8s ease;
  filter: drop-shadow(0 0 18px rgba(var(--pulse-rgb), 0.34));
}

.core-logo-card img,
.hero-showcase-cube {
  transition: filter 2.8s ease;
}

.core-logo-card img {
  filter: drop-shadow(0 0 42px rgba(var(--pulse-rgb), 0.36));
}

.hero-showcase-cube {
  filter: drop-shadow(0 0 30px rgba(var(--pulse-rgb), 0.2));
}

.eyebrow,
.section-heading span,
.showroom-copy span,
.reference-section span,
.contact-section span {
  border-color: rgba(var(--pulse-rgb), 0.26);
  color: var(--pulse-main);
  background: rgba(var(--pulse-rgb), 0.1);
  box-shadow: inset 0 0 18px rgba(var(--pulse-rgb), 0.08);
  transition:
    color 2.8s ease,
    border-color 2.8s ease,
    background 2.8s ease,
    box-shadow 2.8s ease;
}

.hero-copy h1 span {
  background: linear-gradient(90deg, #f5fff0, var(--pulse-soft), var(--pulse-main));
  -webkit-background-clip: text;
  background-clip: text;
  filter: drop-shadow(0 0 20px rgba(var(--pulse-rgb), 0.15));
  transition: filter 2.8s ease;
}

.primary-action {
  border-color: rgba(var(--pulse-rgb), 0.5);
  background: linear-gradient(135deg, var(--pulse-soft), var(--pulse-main));
  box-shadow: 0 18px 45px rgba(var(--pulse-rgb), 0.22);
  transition:
    transform 180ms ease,
    box-shadow 2.8s ease,
    border-color 2.8s ease,
    background 2.8s ease;
}

.primary-action:hover {
  box-shadow: 0 22px 60px rgba(var(--pulse-rgb), 0.34);
}

.secondary-action {
  border-color: rgba(var(--pulse-rgb), 0.36);
  background: rgba(var(--pulse-rgb), 0.08);
}

.secondary-action:hover,
.ghost-action:hover {
  border-color: rgba(var(--pulse-rgb), 0.48);
  background: rgba(var(--pulse-rgb), 0.12);
}

.hero-notes svg,
.launch-line svg,
.card-icon,
.theme-icon,
.theme-card strong,
.step-item span,
.hub-card span,
.panel-kicker {
  color: var(--pulse-main);
  transition: color 2.8s ease, border-color 2.8s ease, background 2.8s ease;
}

.card-icon,
.theme-icon {
  border-color: rgba(var(--pulse-rgb), 0.25);
  background: rgba(var(--pulse-rgb), 0.08);
}

.service-card,
.theme-card,
.reference-grid article,
.hub-card,
.step-item {
  border-color: rgba(var(--pulse-rgb), 0.13);
  transition: border-color 2.8s ease, box-shadow 2.8s ease, background 2.8s ease, transform 180ms ease;
}

.hub-card:hover {
  border-color: rgba(var(--pulse-rgb), 0.32);
  background:
    radial-gradient(circle at 45% 0%, rgba(var(--pulse-rgb), 0.14), transparent 12rem),
    var(--panel);
}

.hub-card.active {
  border-color: rgba(var(--pulse-rgb), 0.42);
  box-shadow: 0 25px 95px rgba(var(--pulse-rgb), 0.12);
}

.section-block,
.showroom-section,
.reference-section,
.contact-section,
.site-footer {
  border-top-color: rgba(var(--pulse-rgb), 0.08);
  transition: border-color 2.8s ease, background 2.8s ease;
}

.showroom-section {
  background:
    radial-gradient(circle at 71% 45%, rgba(var(--pulse-rgb), 0.16), transparent 34rem),
    rgba(255, 255, 255, 0.012);
}

.showroom-note {
  border-left-color: var(--pulse-main);
  transition: border-color 2.8s ease;
}

.contact-section {
  background:
    radial-gradient(circle at 14% 22%, rgba(var(--pulse-rgb), 0.13), transparent 26rem),
    rgba(255, 255, 255, 0.016);
}

.hero-engine-stage::after {
  background:
    radial-gradient(circle at 50% 48%, rgba(var(--pulse-rgb), 0.12), transparent 20rem),
    radial-gradient(circle at 64% 54%, rgba(65, 217, 255, 0.045), transparent 22rem);
  transition: background 2.8s ease;
}

.orbit-track {
  border-color: rgba(var(--pulse-rgb), 0.07);
  transition: border-color 2.8s ease;
}

.orbit-track::before {
  border-color: rgba(var(--pulse-rgb), 0.04);
  transition: border-color 2.8s ease;
}

.planet-green {
  --planet-main: var(--pulse-main);
  --planet-dark: #185e08;
  --planet-light: var(--pulse-soft);
  --planet-glow: rgba(var(--pulse-rgb), 0.55);
}

@media (prefers-reduced-motion: reduce) {
  .app-shell {
    transition: none;
  }
}


/* CES-BUILD-008: Smooth Color Pulse refinement */
.app-shell {
  transition:
    background-color 4s ease,
    color 4s ease;
}

.app-shell::before,
.app-shell::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  transition:
    opacity 4s ease,
    background 4s ease;
}

.app-shell::before {
  opacity: 0.55;
  background:
    radial-gradient(circle at 44% 10%, rgba(var(--pulse-rgb), 0.18), transparent 42rem),
    radial-gradient(circle at 77% 28%, rgba(var(--pulse-rgb), 0.08), transparent 34rem);
}

.app-shell::after {
  opacity: 0.18;
  background:
    linear-gradient(120deg, transparent 0%, rgba(var(--pulse-rgb), 0.16) 48%, transparent 75%);
  mix-blend-mode: screen;
}

.engine-grid,
.site-header,
.brand img,
.core-logo-card img,
.hero-showcase-cube,
.eyebrow,
.section-heading span,
.showroom-copy span,
.reference-section span,
.contact-section span,
.hero-copy h1 span,
.primary-action,
.secondary-action,
.ghost-action,
.card-icon,
.theme-icon,
.service-card,
.theme-card,
.reference-grid article,
.hub-card,
.step-item,
.section-block,
.showroom-section,
.reference-section,
.contact-section,
.site-footer,
.showroom-note,
.hero-engine-stage::after,
.orbit-track,
.orbit-track::before {
  transition-duration: 4s !important;
}

.matrix-rain-canvas {
  transition: opacity 4s ease, filter 4s ease;
}


/* CES-BUILD-009: Anthracite Pulse Background Cleanup
   Entfernt feste rote/cyan Lichtquellen und macht den Hintergrund ruhiger.
*/
.app-shell {
  background:
    radial-gradient(circle at 68% 42%, rgba(var(--pulse-rgb), 0.16), transparent 34rem),
    radial-gradient(circle at 43% 14%, rgba(var(--pulse-rgb), 0.09), transparent 42rem),
    linear-gradient(135deg, #050706 0%, #090d0a 42%, #030403 100%) !important;
}

.app-shell.tone-green,
.app-shell.tone-cyan,
.app-shell.tone-purple,
.app-shell.tone-red {
  background:
    radial-gradient(circle at 68% 42%, rgba(var(--pulse-rgb), 0.16), transparent 34rem),
    radial-gradient(circle at 43% 14%, rgba(var(--pulse-rgb), 0.09), transparent 42rem),
    linear-gradient(135deg, #050706 0%, #090d0a 42%, #030403 100%) !important;
}

/* Alte statische Lichtquellen aus früheren Builds deaktivieren */
.ambient-red,
.ambient-cyan {
  display: none !important;
}

.ambient-green {
  background: rgba(var(--pulse-rgb), 0.13) !important;
  opacity: 0.48 !important;
  transition: background 4s ease, opacity 4s ease;
}

/* Die zusätzlichen Smooth-Pulse-Overlays bleiben, aber ohne harte Lichtflächen */
.app-shell::before {
  opacity: 0.34 !important;
  background:
    radial-gradient(circle at 62% 43%, rgba(var(--pulse-rgb), 0.13), transparent 30rem),
    radial-gradient(circle at 48% 16%, rgba(var(--pulse-rgb), 0.07), transparent 36rem) !important;
}

.app-shell::after {
  opacity: 0.07 !important;
  background:
    linear-gradient(120deg, transparent 0%, rgba(var(--pulse-rgb), 0.11) 50%, transparent 78%) !important;
}

/* Sektionen bekommen keinen eigenen farbigen Fremdglow mehr */
.showroom-section,
.contact-section {
  background:
    radial-gradient(circle at 70% 45%, rgba(var(--pulse-rgb), 0.08), transparent 30rem),
    rgba(255, 255, 255, 0.008) !important;
}

.hero-engine-stage::after {
  background:
    radial-gradient(circle at 50% 48%, rgba(var(--pulse-rgb), 0.09), transparent 20rem) !important;
}

/* Matrix bleibt sichtbar, aber die farbigen Hintergrundfelder werden ruhiger */
.matrix-rain-canvas {
  opacity: 0.2 !important;
}

/* Grid etwas neutraler, damit die Pulse-Farbe nicht als harte Fläche wirkt */
.engine-grid {
  opacity: 0.22 !important;
  background-image:
    linear-gradient(rgba(var(--pulse-rgb), 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--pulse-rgb), 0.055) 1px, transparent 1px) !important;
}


/* CES-BUILD-010: Cube Only Hero
   Entfernt Planeten, Orbitbahnen und Orbit-Label im Hero.
*/
.core-orbit-system,
.orbit-track,
.orbit-planet,
.launch-line,
.hero-orbit {
  display: none !important;
}

.hero-engine-stage {
  min-height: 48rem;
  display: grid;
  place-items: center;
}

.hero-showcase-cube {
  width: min(100%, 46rem);
  filter:
    drop-shadow(0 0 28px rgba(var(--pulse-rgb), 0.22))
    drop-shadow(0 0 75px rgba(var(--pulse-rgb), 0.12));
}

.hero-engine-stage::after {
  background:
    radial-gradient(circle at 50% 48%, rgba(var(--pulse-rgb), 0.11), transparent 21rem),
    radial-gradient(circle at 50% 52%, rgba(255, 255, 255, 0.025), transparent 32rem) !important;
}


/* CES-BUILD-011: Premium Hero Composition */
.hero-section {
  grid-template-columns: minmax(30rem, 0.72fr) minmax(34rem, 1.28fr);
  gap: clamp(2.5rem, 5vw, 7rem);
  align-items: center;
  padding-top: clamp(2.8rem, 4.5vw, 5.4rem);
  padding-bottom: clamp(3.2rem, 5vw, 6rem);
}

.premium-hero-copy {
  max-width: 760px;
  padding-left: clamp(0rem, 1vw, 1.25rem);
}

.hero-brandline {
  display: grid;
  gap: 0.42rem;
  margin-top: 1.35rem;
  margin-bottom: 1.1rem;
}

.hero-brandline span {
  color: var(--pulse-main);
  font-size: clamp(1.1rem, 1.4vw, 1.45rem);
  font-weight: 900;
  letter-spacing: -0.035em;
  text-shadow: 0 0 20px rgba(var(--pulse-rgb), 0.22);
  transition: color 4s ease, text-shadow 4s ease;
}

.hero-brandline strong {
  max-width: 42rem;
  color: rgba(245, 255, 240, 0.78);
  font-size: clamp(0.9rem, 1.1vw, 1.08rem);
  font-weight: 700;
  line-height: 1.45;
  letter-spacing: 0.01em;
}

.premium-hero-copy h1 {
  max-width: 780px;
  margin: 0 0 1.15rem;
  font-size: clamp(3.4rem, 5.9vw, 7.2rem);
  line-height: 0.92;
  letter-spacing: -0.085em;
}

.premium-hero-copy h1 span {
  display: block;
  margin-top: 0.12em;
}

.premium-hero-copy .hero-lead {
  max-width: 700px;
  color: rgba(230, 244, 224, 0.84);
  font-size: clamp(1rem, 1.25vw, 1.16rem);
}

.hero-module-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.85rem;
  margin-top: 2.1rem;
  max-width: 760px;
}

.hero-module-strip article {
  position: relative;
  min-height: 7.4rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.14);
  border-radius: 1.25rem;
  padding: 1rem;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 0%, rgba(var(--pulse-rgb), 0.12), transparent 9rem),
    rgba(7, 15, 8, 0.62);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(16px);
  transition: border-color 4s ease, background 4s ease, box-shadow 4s ease, transform 180ms ease;
}

.hero-module-strip article:hover {
  transform: translateY(-3px);
  border-color: rgba(var(--pulse-rgb), 0.28);
  box-shadow: 0 22px 70px rgba(var(--pulse-rgb), 0.09);
}

.hero-module-strip span {
  display: inline-flex;
  margin-bottom: 0.72rem;
  color: var(--pulse-main);
  font-size: 0.78rem;
  font-weight: 950;
  transition: color 4s ease;
}

.hero-module-strip strong {
  display: block;
  color: var(--text);
  font-size: 1rem;
  letter-spacing: -0.03em;
}

.hero-module-strip small {
  display: block;
  margin-top: 0.42rem;
  color: var(--muted);
  font-size: 0.78rem;
  line-height: 1.45;
}

.hero-engine-stage {
  min-height: 49rem;
  justify-items: center;
  align-items: center;
}

.hero-showcase-cube {
  transform: translateX(-1vw);
}

@media (max-width: 1180px) {
  .hero-section {
    grid-template-columns: 1fr;
  }

  .premium-hero-copy {
    max-width: 980px;
  }

  .premium-hero-copy h1 {
    max-width: 930px;
  }

  .hero-showcase-cube {
    transform: none;
  }
}

@media (max-width: 760px) {
  .premium-hero-copy h1 {
    font-size: clamp(3.05rem, 14vw, 5.6rem);
  }

  .hero-module-strip {
    grid-template-columns: 1fr;
  }
}


/* CES-BUILD-012: Hero Width + Typography Fix
   Ziel: Farbverlauf bleibt, aber die Headline wird kleiner, breiter und wirkt nicht mehr gekappt/gequetscht.
*/
.hero-section {
  grid-template-columns: minmax(42rem, 0.96fr) minmax(31rem, 1.04fr);
  gap: clamp(2rem, 3.6vw, 5rem);
}

.premium-hero-copy {
  max-width: min(60rem, 100%);
  padding-left: clamp(0.25rem, 0.8vw, 1rem);
}

.premium-hero-copy h1 {
  max-width: 60rem;
  width: 100%;
  font-size: clamp(3.15rem, 4.85vw, 5.95rem);
  line-height: 1.02;
  letter-spacing: -0.065em;
  margin-bottom: 1.25rem;
  overflow: visible;
  text-wrap: balance;
}

.premium-hero-copy h1 span {
  display: block;
  margin-top: 0.08em;
  white-space: nowrap;
}

.premium-hero-copy .hero-lead {
  max-width: 48rem;
}

.hero-module-strip {
  max-width: 48rem;
}

.hero-actions {
  margin-top: 1.75rem;
}

.hero-engine-stage {
  min-height: 48rem;
}

.hero-showcase-cube {
  transform: translateX(0);
  width: min(100%, 44rem);
}

/* Bei mittleren Breiten darf die Schrift umbrechen, aber nicht gedrückt wirken. */
@media (max-width: 1320px) {
  .hero-section {
    grid-template-columns: minmax(34rem, 0.9fr) minmax(29rem, 1.1fr);
  }

  .premium-hero-copy h1 {
    font-size: clamp(3rem, 4.6vw, 5.2rem);
    max-width: 52rem;
  }
}

@media (max-width: 1180px) {
  .hero-section {
    grid-template-columns: 1fr;
  }

  .premium-hero-copy {
    max-width: 100%;
  }

  .premium-hero-copy h1 {
    max-width: 58rem;
  }

  .premium-hero-copy h1 span {
    white-space: normal;
  }
}

@media (max-width: 760px) {
  .premium-hero-copy h1 {
    font-size: clamp(2.55rem, 11vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .premium-hero-copy h1 span {
    white-space: normal;
  }
}


/* CES-BUILD-013: Engine Descender Fix
   Fix: Das "g" in Engine darf nicht mehr optisch abgeschnitten/gequetscht wirken.
*/
.premium-hero-copy h1 {
  line-height: 1.08;
  padding-bottom: 0.16em;
  margin-bottom: 1.05rem;
  overflow: visible;
}

.premium-hero-copy h1 span {
  line-height: 1.08;
  padding-bottom: 0.08em;
  overflow: visible;
}

.hero-section,
.premium-hero-copy {
  overflow: visible;
}

@media (max-width: 760px) {
  .premium-hero-copy h1 {
    line-height: 1.06;
    padding-bottom: 0.18em;
  }
}


/* CES-BUILD-014: Smooth Pulse + Descender Fix
   1) Farbwechsel läuft jetzt über weich interpolierte CSS-Variablen per JS.
   2) Das "g" in Engine bekommt deutlich mehr Unterlänge-Luft.
*/
.hero-section,
.premium-hero-copy,
.premium-hero-copy h1,
.premium-hero-copy h1 span {
  overflow: visible !important;
}

.premium-hero-copy h1 {
  line-height: 1.14 !important;
  padding-bottom: 0.34em !important;
  margin-bottom: 0.65rem !important;
}

.premium-hero-copy h1 span {
  display: inline-block !important;
  line-height: 1.14 !important;
  padding-bottom: 0.32em !important;
  overflow: visible !important;
}

/* Die großen Farbflächen folgen jetzt nur noch den weich interpolierten Variablen. */
.app-shell {
  background:
    radial-gradient(circle at 68% 42%, rgba(var(--pulse-rgb), 0.14), transparent 34rem),
    radial-gradient(circle at 43% 14%, rgba(var(--pulse-rgb), 0.075), transparent 42rem),
    linear-gradient(135deg, #050706 0%, #090d0a 42%, #030403 100%) !important;
}

/* Keine harten Tone-Klassen mehr: diese Selektoren bleiben nur als Fallback neutral. */
.app-shell.tone-green,
.app-shell.tone-cyan,
.app-shell.tone-purple,
.app-shell.tone-red {
  background:
    radial-gradient(circle at 68% 42%, rgba(var(--pulse-rgb), 0.14), transparent 34rem),
    radial-gradient(circle at 43% 14%, rgba(var(--pulse-rgb), 0.075), transparent 42rem),
    linear-gradient(135deg, #050706 0%, #090d0a 42%, #030403 100%) !important;
}

.hero-copy h1 span,
.primary-action,
.secondary-action,
.ghost-action,
.eyebrow,
.section-heading span,
.showroom-copy span,
.reference-section span,
.contact-section span,
.engine-grid,
.hero-showcase-cube,
.card-icon,
.theme-icon,
.service-card,
.theme-card,
.reference-grid article,
.hub-card,
.step-item {
  transition-duration: 4.5s !important;
}

@media (max-width: 760px) {
  .premium-hero-copy h1 {
    line-height: 1.12 !important;
    padding-bottom: 0.38em !important;
  }

  .premium-hero-copy h1 span {
    padding-bottom: 0.36em !important;
  }
}


/* CES-BUILD-015: Services Section Upgrade */
.services-section {
  padding-top: clamp(4.2rem, 6vw, 7.5rem);
}

.services-heading {
  max-width: 1120px;
}

.services-heading h2 {
  max-width: 980px;
}

.services-layout {
  display: grid;
  grid-template-columns: minmax(20rem, 0.72fr) minmax(0, 1.28fr);
  gap: 1rem;
  align-items: stretch;
}

.service-lead-card {
  position: relative;
  min-height: 100%;
  border: 1px solid rgba(var(--pulse-rgb), 0.16);
  border-radius: 1.65rem;
  padding: clamp(1.25rem, 2vw, 1.8rem);
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 0%, rgba(var(--pulse-rgb), 0.17), transparent 16rem),
    linear-gradient(145deg, rgba(255, 255, 255, 0.055), transparent 56%),
    rgba(7, 15, 8, 0.66);
  box-shadow: 0 30px 100px rgba(0, 0, 0, 0.34);
  backdrop-filter: blur(18px);
  transition: border-color 4.5s ease, background 4.5s ease, box-shadow 4.5s ease;
}

.service-lead-card::after {
  content: "";
  position: absolute;
  right: -18%;
  bottom: -18%;
  width: 22rem;
  height: 22rem;
  border-radius: 50%;
  background: rgba(var(--pulse-rgb), 0.11);
  filter: blur(34px);
}

.service-lead-topline {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 0.35rem;
  margin-bottom: 2rem;
}

.service-lead-topline span {
  width: fit-content;
  border: 1px solid rgba(var(--pulse-rgb), 0.24);
  border-radius: 999px;
  padding: 0.42rem 0.65rem;
  color: var(--pulse-main);
  background: rgba(var(--pulse-rgb), 0.09);
  font-size: 0.76rem;
  font-weight: 900;
  transition: color 4.5s ease, border-color 4.5s ease, background 4.5s ease;
}

.service-lead-topline strong {
  color: rgba(245, 255, 240, 0.78);
  font-size: 0.88rem;
}

.service-lead-card h3 {
  position: relative;
  z-index: 2;
  max-width: 26rem;
  margin: 0 0 1rem;
  font-size: clamp(2rem, 3vw, 3.25rem);
  line-height: 0.96;
  letter-spacing: -0.065em;
}

.service-lead-card p {
  position: relative;
  z-index: 2;
  max-width: 31rem;
  margin: 0;
  color: var(--muted);
  line-height: 1.75;
}

.service-lead-flow {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  align-items: center;
  margin-top: 2rem;
}

.service-lead-flow span {
  display: inline-flex;
  align-items: center;
  min-height: 2.3rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.14);
  border-radius: 999px;
  padding: 0 0.78rem;
  color: var(--text);
  background: rgba(255, 255, 255, 0.035);
  font-size: 0.82rem;
  font-weight: 800;
}

.service-lead-flow svg {
  color: var(--pulse-main);
  transition: color 4.5s ease;
}

.premium-service-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.premium-service-card {
  min-height: 18.2rem;
  display: flex;
  flex-direction: column;
  padding: 1.2rem;
}

.service-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
}

.service-card-header > span {
  color: rgba(245, 255, 240, 0.22);
  font-size: 1.4rem;
  font-weight: 950;
  letter-spacing: -0.06em;
}

.premium-service-card small {
  color: var(--pulse-main);
  font-size: 0.76rem;
  font-weight: 900;
  letter-spacing: 0.02em;
  transition: color 4.5s ease;
}

.premium-service-card h3 {
  margin: 0.44rem 0 0.55rem;
  font-size: clamp(1.25rem, 1.6vw, 1.62rem);
  letter-spacing: -0.045em;
}

.premium-service-card p {
  flex: 1;
  color: rgba(226, 238, 220, 0.72);
}

.premium-service-card ul {
  display: grid;
  gap: 0.45rem;
  margin: 1rem 0 0;
  padding: 0;
  list-style: none;
}

.premium-service-card li {
  display: flex;
  align-items: center;
  gap: 0.42rem;
  color: rgba(245, 255, 240, 0.72);
  font-size: 0.82rem;
}

.premium-service-card li svg {
  flex: 0 0 auto;
  color: var(--pulse-main);
  transition: color 4.5s ease;
}

@media (max-width: 1180px) {
  .services-layout {
    grid-template-columns: 1fr;
  }

  .premium-service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .service-lead-card {
    min-height: 20rem;
  }
}

@media (max-width: 760px) {
  .premium-service-grid {
    grid-template-columns: 1fr;
  }

  .service-lead-flow {
    align-items: flex-start;
  }

  .service-lead-flow svg {
    display: none;
  }
}


/* CES-BUILD-016: Service Engine Flow */
.service-lead-card {
  display: flex;
  flex-direction: column;
}

.service-engine-visual {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: clamp(18rem, 24vw, 24rem);
  margin-top: 1.5rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.13);
  border-radius: 1.45rem;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 50%, rgba(var(--pulse-rgb), 0.13), transparent 10rem),
    linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 55%),
    rgba(0, 0, 0, 0.16);
  box-shadow:
    inset 0 0 42px rgba(var(--pulse-rgb), 0.055),
    0 22px 70px rgba(0, 0, 0, 0.22);
  transition:
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.flow-grid-bg {
  position: absolute;
  inset: 0;
  opacity: 0.34;
  background-image:
    linear-gradient(rgba(var(--pulse-rgb), 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--pulse-rgb), 0.07) 1px, transparent 1px);
  background-size: 34px 34px;
  mask-image: radial-gradient(circle at center, #000 0%, transparent 78%);
  transition: background-image 4.5s ease;
}

.flow-core {
  position: absolute;
  left: 50%;
  top: 50%;
  display: grid;
  place-items: center;
  width: clamp(6.5rem, 8.5vw, 8.2rem);
  height: clamp(6.5rem, 8.5vw, 8.2rem);
  transform: translate(-50%, -50%);
  border: 1px solid rgba(var(--pulse-rgb), 0.34);
  border-radius: 50%;
  color: var(--text);
  background:
    radial-gradient(circle at 35% 30%, rgba(255,255,255,0.18), transparent 18%),
    radial-gradient(circle at 50% 50%, rgba(var(--pulse-rgb), 0.3), rgba(var(--pulse-rgb), 0.08) 48%, rgba(0,0,0,0.16) 72%);
  box-shadow:
    0 0 34px rgba(var(--pulse-rgb), 0.23),
    inset -12px -14px 24px rgba(0, 0, 0, 0.38),
    inset 8px 8px 18px rgba(255, 255, 255, 0.08);
  animation: engine-core-breathe 4.8s ease-in-out infinite;
  transition:
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.flow-core::before,
.flow-core::after {
  content: "";
  position: absolute;
  inset: -1.2rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.1);
  border-radius: inherit;
  animation: engine-ring-spin 18s linear infinite;
}

.flow-core::after {
  inset: -2.4rem;
  opacity: 0.55;
  animation-direction: reverse;
  animation-duration: 28s;
}

.flow-core span {
  margin-top: 0.7rem;
  color: var(--pulse-main);
  font-size: 0.72rem;
  font-weight: 950;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  transition: color 4.5s ease;
}

.flow-core strong {
  margin-top: -1.15rem;
  font-size: clamp(1.1rem, 1.5vw, 1.45rem);
  letter-spacing: -0.05em;
}

.flow-node {
  position: absolute;
  display: grid;
  gap: 0.18rem;
  min-width: 7.2rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.16);
  border-radius: 1rem;
  padding: 0.72rem 0.82rem;
  color: var(--text);
  background:
    radial-gradient(circle at 18% 0%, rgba(var(--pulse-rgb), 0.14), transparent 6rem),
    rgba(4, 10, 5, 0.76);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.26);
  backdrop-filter: blur(16px);
  transition:
    transform 180ms ease,
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.flow-node:hover {
  transform: translateY(-3px);
  border-color: rgba(var(--pulse-rgb), 0.32);
  box-shadow: 0 20px 65px rgba(var(--pulse-rgb), 0.11);
}

.flow-node span {
  color: var(--pulse-main);
  font-size: 0.7rem;
  font-weight: 950;
  transition: color 4.5s ease;
}

.flow-node strong {
  font-size: 0.9rem;
  letter-spacing: -0.025em;
}

.flow-node-design {
  left: 8%;
  top: 18%;
}

.flow-node-web {
  right: 7%;
  top: 20%;
}

.flow-node-system {
  left: 9%;
  bottom: 16%;
}

.flow-node-auto {
  right: 7%;
  bottom: 14%;
}

.flow-path {
  position: absolute;
  height: 2px;
  transform-origin: left center;
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(var(--pulse-rgb), 0.16),
      rgba(var(--pulse-rgb), 0.5),
      rgba(var(--pulse-rgb), 0.16),
      transparent
    );
  box-shadow: 0 0 16px rgba(var(--pulse-rgb), 0.18);
  transition: background 4.5s ease, box-shadow 4.5s ease;
}

.flow-path-a {
  left: 24%;
  top: 32%;
  width: 30%;
  transform: rotate(19deg);
}

.flow-path-b {
  left: 50%;
  top: 38%;
  width: 28%;
  transform: rotate(-17deg);
}

.flow-path-c {
  left: 24%;
  bottom: 31%;
  width: 31%;
  transform: rotate(-18deg);
}

.flow-path-d {
  left: 50%;
  bottom: 32%;
  width: 29%;
  transform: rotate(17deg);
}

.data-pulse {
  position: absolute;
  width: 0.68rem;
  height: 0.68rem;
  border-radius: 50%;
  background: var(--pulse-main);
  box-shadow:
    0 0 16px rgba(var(--pulse-rgb), 0.74),
    0 0 34px rgba(var(--pulse-rgb), 0.34);
  transition:
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.pulse-one {
  left: 17%;
  top: 26%;
  animation: pulse-route-one 4.8s ease-in-out infinite;
}

.pulse-two {
  right: 18%;
  top: 28%;
  animation: pulse-route-two 5.4s ease-in-out infinite 0.6s;
}

.pulse-three {
  left: 18%;
  bottom: 22%;
  animation: pulse-route-three 5.1s ease-in-out infinite 1.1s;
}

.pulse-four {
  right: 18%;
  bottom: 20%;
  animation: pulse-route-four 5.7s ease-in-out infinite 1.6s;
}

@keyframes engine-core-breathe {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.035);
  }
}

@keyframes engine-ring-spin {
  from {
    transform: rotate(0deg) scaleX(1);
  }
  to {
    transform: rotate(360deg) scaleX(1);
  }
}

@keyframes pulse-route-one {
  0%, 100% {
    transform: translate(0, 0) scale(0.75);
    opacity: 0.38;
  }
  50% {
    transform: translate(210%, 132%) scale(1.1);
    opacity: 1;
  }
}

@keyframes pulse-route-two {
  0%, 100% {
    transform: translate(0, 0) scale(0.75);
    opacity: 0.38;
  }
  50% {
    transform: translate(-215%, 116%) scale(1.1);
    opacity: 1;
  }
}

@keyframes pulse-route-three {
  0%, 100% {
    transform: translate(0, 0) scale(0.75);
    opacity: 0.38;
  }
  50% {
    transform: translate(220%, -124%) scale(1.1);
    opacity: 1;
  }
}

@keyframes pulse-route-four {
  0%, 100% {
    transform: translate(0, 0) scale(0.75);
    opacity: 0.38;
  }
  50% {
    transform: translate(-220%, -132%) scale(1.1);
    opacity: 1;
  }
}

@media (max-width: 1180px) {
  .service-engine-visual {
    min-height: 22rem;
  }
}

@media (max-width: 760px) {
  .service-engine-visual {
    min-height: 28rem;
  }

  .flow-node {
    min-width: 6.4rem;
    padding: 0.65rem 0.7rem;
  }

  .flow-node-design {
    left: 5%;
    top: 12%;
  }

  .flow-node-web {
    right: 5%;
    top: 14%;
  }

  .flow-node-system {
    left: 5%;
    bottom: 13%;
  }

  .flow-node-auto {
    right: 5%;
    bottom: 12%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .flow-core,
  .flow-core::before,
  .flow-core::after,
  .data-pulse {
    animation: none !important;
  }
}


/* CES-BUILD-017: Service Flow Typography Polish
   Ziel: Das zentrale Flow-Element wirkt ruhiger, hochwertiger und nicht mehr zu tief/unsauber.
*/
.refined-flow-core {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.08rem;
  transform: translate(-50%, -54%) !important;
}

.refined-flow-core span {
  margin: 0 !important;
  color: rgba(245, 255, 240, 0.74) !important;
  font-size: 0.64rem !important;
  font-weight: 950 !important;
  letter-spacing: 0.22em !important;
  line-height: 1 !important;
  text-transform: uppercase;
}

.refined-flow-core strong {
  margin: 0 !important;
  color: var(--text) !important;
  font-size: clamp(1.18rem, 1.55vw, 1.58rem) !important;
  line-height: 1 !important;
  letter-spacing: 0.02em !important;
  text-transform: uppercase;
  text-shadow:
    0 0 16px rgba(var(--pulse-rgb), 0.34),
    0 1px 0 rgba(255, 255, 255, 0.12);
}

.refined-flow-core small {
  margin: 0.08rem 0 0;
  color: var(--pulse-main);
  font-size: 0.55rem;
  font-weight: 950;
  letter-spacing: 0.26em;
  line-height: 1;
  text-transform: uppercase;
  transition: color 4.5s ease;
}

.flow-node {
  color: rgba(245, 255, 240, 0.88);
}

.flow-node span {
  color: rgba(245, 255, 240, 0.68) !important;
}

.flow-node strong {
  color: rgba(245, 255, 240, 0.95);
  font-size: 0.86rem;
  letter-spacing: -0.01em;
}

.flow-node::after {
  content: "";
  position: absolute;
  right: 0.72rem;
  top: 50%;
  width: 0.44rem;
  height: 0.44rem;
  transform: translateY(-50%);
  border-radius: 50%;
  background: var(--pulse-main);
  box-shadow: 0 0 14px rgba(var(--pulse-rgb), 0.48);
  transition: background 4.5s ease, box-shadow 4.5s ease;
}

/* Der bisherige Datenpunkt direkt neben manchen Nodes wirkte farblich etwas unruhig.
   Durch neutralere Typo und Pulse-dot bleibt der Look technischer. */
.flow-node-design,
.flow-node-web,
.flow-node-system,
.flow-node-auto {
  border-color: rgba(var(--pulse-rgb), 0.14);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.045), transparent 55%),
    rgba(4, 10, 5, 0.72);
}

.flow-core {
  top: 50%;
}

@keyframes engine-core-breathe {
  0%, 100% {
    transform: translate(-50%, -54%) scale(1);
  }
  50% {
    transform: translate(-50%, -54%) scale(1.032);
  }
}

.service-engine-visual {
  background:
    radial-gradient(circle at 50% 48%, rgba(var(--pulse-rgb), 0.105), transparent 10rem),
    linear-gradient(135deg, rgba(255, 255, 255, 0.035), transparent 55%),
    rgba(0, 0, 0, 0.18);
}

.flow-path {
  opacity: 0.82;
}

.data-pulse {
  width: 0.58rem;
  height: 0.58rem;
  opacity: 0.88;
}

@media (max-width: 760px) {
  .refined-flow-core {
    transform: translate(-50%, -54%) scale(0.95) !important;
  }
}


/* CES-BUILD-018: Service Flow Color Glow
   Korrektur: Die Flow-Typografie soll NICHT dezent weiß sein,
   sondern stärker zum Neon-/Pulse-Stil passen.
*/
.refined-flow-core span {
  color: var(--pulse-main) !important;
  text-shadow:
    0 0 10px rgba(var(--pulse-rgb), 0.55),
    0 0 24px rgba(var(--pulse-rgb), 0.28) !important;
}

.refined-flow-core strong {
  color: var(--pulse-soft) !important;
  background: linear-gradient(90deg, #ffffff, var(--pulse-soft), var(--pulse-main));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent !important;
  text-shadow:
    0 0 20px rgba(var(--pulse-rgb), 0.42),
    0 0 42px rgba(var(--pulse-rgb), 0.18) !important;
  filter: drop-shadow(0 0 10px rgba(var(--pulse-rgb), 0.3));
}

.refined-flow-core small {
  color: var(--pulse-main) !important;
  text-shadow:
    0 0 10px rgba(var(--pulse-rgb), 0.55),
    0 0 24px rgba(var(--pulse-rgb), 0.24);
}

.flow-node span {
  color: var(--pulse-main) !important;
  text-shadow: 0 0 12px rgba(var(--pulse-rgb), 0.42);
}

.flow-node strong {
  color: var(--pulse-soft) !important;
  text-shadow:
    0 0 10px rgba(var(--pulse-rgb), 0.28),
    0 0 22px rgba(var(--pulse-rgb), 0.12);
}

.flow-node-design,
.flow-node-web,
.flow-node-system,
.flow-node-auto {
  border-color: rgba(var(--pulse-rgb), 0.22) !important;
  background:
    radial-gradient(circle at 14% 0%, rgba(var(--pulse-rgb), 0.18), transparent 5.8rem),
    linear-gradient(135deg, rgba(var(--pulse-rgb), 0.065), transparent 58%),
    rgba(4, 10, 5, 0.74) !important;
}

.flow-node::after {
  background: var(--pulse-main) !important;
  box-shadow:
    0 0 16px rgba(var(--pulse-rgb), 0.76),
    0 0 36px rgba(var(--pulse-rgb), 0.32) !important;
}

.flow-core {
  border-color: rgba(var(--pulse-rgb), 0.42) !important;
  box-shadow:
    0 0 36px rgba(var(--pulse-rgb), 0.27),
    inset -12px -14px 24px rgba(0, 0, 0, 0.38),
    inset 8px 8px 18px rgba(255, 255, 255, 0.08) !important;
}

.flow-core::before,
.flow-core::after {
  border-color: rgba(var(--pulse-rgb), 0.16) !important;
}


/* CES-BUILD-019: Service Flow Gradient Sweep
   Die ServiceFlow-Schrift nutzt jetzt aktuelle + nächste Pulse-Farbe.
   Kein weißer Start im F mehr, sondern ein laufender Akzentverlauf.
*/
.app-shell {
  --pulse-next-rgb: 65, 217, 255;
  --pulse-next-main: rgb(65, 217, 255);
  --pulse-next-soft: rgb(191, 244, 255);
  --pulse-next-glow: rgba(65, 217, 255, 0.28);
}

.refined-flow-core span,
.refined-flow-core strong,
.refined-flow-core small,
.flow-node span,
.flow-node strong {
  background:
    linear-gradient(
      110deg,
      var(--pulse-main) 0%,
      var(--pulse-soft) 22%,
      var(--pulse-next-main) 48%,
      var(--pulse-next-soft) 64%,
      var(--pulse-main) 100%
    ) !important;
  background-size: 240% 100% !important;
  background-position: 100% 50%;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  animation: service-flow-text-sweep 7.5s ease-in-out infinite;
  transition:
    filter 4.5s ease,
    text-shadow 4.5s ease;
}

.refined-flow-core span,
.refined-flow-core small {
  filter:
    drop-shadow(0 0 8px rgba(var(--pulse-rgb), 0.38))
    drop-shadow(0 0 12px rgba(var(--pulse-next-rgb), 0.18));
}

.refined-flow-core strong {
  filter:
    drop-shadow(0 0 12px rgba(var(--pulse-rgb), 0.45))
    drop-shadow(0 0 24px rgba(var(--pulse-next-rgb), 0.22));
  text-shadow: none !important;
}

.flow-node span,
.flow-node strong {
  filter:
    drop-shadow(0 0 7px rgba(var(--pulse-rgb), 0.34))
    drop-shadow(0 0 12px rgba(var(--pulse-next-rgb), 0.16));
  text-shadow: none !important;
}

.flow-node-web span,
.flow-node-web strong,
.flow-node-auto span,
.flow-node-auto strong {
  animation-delay: -2.5s;
}

.flow-node-system span,
.flow-node-system strong {
  animation-delay: -4.8s;
}

.flow-core {
  background:
    radial-gradient(circle at 35% 30%, rgba(var(--pulse-next-rgb), 0.16), transparent 18%),
    radial-gradient(circle at 50% 50%, rgba(var(--pulse-rgb), 0.3), rgba(var(--pulse-next-rgb), 0.12) 48%, rgba(0,0,0,0.16) 72%) !important;
  box-shadow:
    0 0 36px rgba(var(--pulse-rgb), 0.25),
    0 0 52px rgba(var(--pulse-next-rgb), 0.12),
    inset -12px -14px 24px rgba(0, 0, 0, 0.38),
    inset 8px 8px 18px rgba(255, 255, 255, 0.08) !important;
}

.flow-node::after,
.data-pulse {
  background: linear-gradient(135deg, var(--pulse-main), var(--pulse-next-main)) !important;
  box-shadow:
    0 0 16px rgba(var(--pulse-rgb), 0.62),
    0 0 32px rgba(var(--pulse-next-rgb), 0.24) !important;
}

.flow-path {
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(var(--pulse-rgb), 0.16),
      rgba(var(--pulse-next-rgb), 0.42),
      rgba(var(--pulse-rgb), 0.42),
      transparent
    ) !important;
  box-shadow:
    0 0 16px rgba(var(--pulse-rgb), 0.16),
    0 0 24px rgba(var(--pulse-next-rgb), 0.1) !important;
}

@keyframes service-flow-text-sweep {
  0% {
    background-position: 115% 50%;
  }
  45% {
    background-position: 0% 50%;
  }
  100% {
    background-position: -115% 50%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .refined-flow-core span,
  .refined-flow-core strong,
  .refined-flow-core small,
  .flow-node span,
  .flow-node strong {
    animation: none !important;
    background-position: 50% 50%;
  }
}


/* CES-BUILD-020: Global Gradient Typography
   Große weiße Headline-Blöcke werden durch den Current/Next-Core-Gradient ersetzt.
   Normale Lesetexte bleiben bewusst ruhig und hell.
*/
:root {
  --core-type-shadow:
    0 0 18px rgba(var(--pulse-rgb), 0.18),
    0 0 30px rgba(var(--pulse-next-rgb), 0.10);
}

.app-shell .hero-copy h1,
.app-shell .hero-copy h1 span,
.app-shell .section-heading h2,
.app-shell .service-lead-card h3,
.app-shell .premium-service-card h3,
.app-shell .showroom-copy h2,
.app-shell .theme-card h3,
.app-shell .reference-section h2,
.app-shell .contact-section h2 {
  background:
    linear-gradient(
      112deg,
      var(--pulse-soft) 0%,
      var(--pulse-main) 24%,
      var(--pulse-next-main) 52%,
      var(--pulse-next-soft) 70%,
      var(--pulse-main) 100%
    ) !important;
  background-size: 260% 100% !important;
  background-position: 105% 50%;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent;
  animation: global-heading-gradient-sweep 10s ease-in-out infinite;
  filter:
    drop-shadow(0 0 12px rgba(var(--pulse-rgb), 0.16))
    drop-shadow(0 0 20px rgba(var(--pulse-next-rgb), 0.08));
  text-shadow: none !important;
  transition:
    filter 4.5s ease,
    background 4.5s ease;
}

/* Hero bleibt stärker und kontrastreicher als die darunterliegenden Bereiche. */
.app-shell .hero-copy h1,
.app-shell .hero-copy h1 span {
  background:
    linear-gradient(
      112deg,
      #f6fff1 0%,
      var(--pulse-soft) 18%,
      var(--pulse-main) 42%,
      var(--pulse-next-main) 66%,
      var(--pulse-soft) 100%
    ) !important;
  background-size: 260% 100% !important;
  animation-duration: 11s;
  filter:
    drop-shadow(0 0 14px rgba(var(--pulse-rgb), 0.18))
    drop-shadow(0 0 26px rgba(var(--pulse-next-rgb), 0.08));
}

/* Kleinere Titel bekommen denselben Stil, aber etwas ruhiger. */
.app-shell .premium-service-card h3,
.app-shell .theme-card h3 {
  filter:
    drop-shadow(0 0 8px rgba(var(--pulse-rgb), 0.13))
    drop-shadow(0 0 14px rgba(var(--pulse-next-rgb), 0.06));
  animation-duration: 12.5s;
}

/* Kicker/Akzenttexte werden vereinheitlicht, ohne normale Texte bunt zu machen. */
.app-shell .hero-brandline span,
.app-shell .premium-service-card small,
.app-shell .service-lead-topline span,
.app-shell .section-heading span,
.app-shell .showroom-copy span,
.app-shell .reference-section span,
.app-shell .contact-section span,
.app-shell .theme-card strong,
.app-shell .hub-card span,
.app-shell .step-item span {
  background:
    linear-gradient(
      105deg,
      var(--pulse-main),
      var(--pulse-next-main),
      var(--pulse-soft)
    );
  background-size: 220% 100%;
  background-position: 100% 50%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent !important;
  -webkit-text-fill-color: transparent;
  animation: global-heading-gradient-sweep 12s ease-in-out infinite;
  filter: drop-shadow(0 0 9px rgba(var(--pulse-rgb), 0.18));
}

/* Badges behalten ihre Pills, aber der Text innen pulsiert einheitlich. */
.app-shell .eyebrow {
  border-color: rgba(var(--pulse-rgb), 0.26) !important;
  background: rgba(var(--pulse-rgb), 0.09) !important;
}

.app-shell .eyebrow,
.app-shell .eyebrow svg {
  color: var(--pulse-main);
}

/* Hauptabschnitts-Headlines brauchen mehr Luft, damit Gradient/Glow nicht abgeschnitten wirkt. */
.app-shell .section-heading h2,
.app-shell .showroom-copy h2,
.app-shell .reference-section h2,
.app-shell .contact-section h2,
.app-shell .service-lead-card h3 {
  overflow: visible !important;
  padding-bottom: 0.08em;
}

/* Buttons bleiben lesbar, aber Primary bekommt stärkeren Current/Next-Verlauf. */
.primary-action {
  background:
    linear-gradient(
      135deg,
      var(--pulse-main),
      var(--pulse-next-main),
      var(--pulse-soft)
    ) !important;
  background-size: 220% 100% !important;
  animation: global-button-gradient-sweep 9.5s ease-in-out infinite;
}

@keyframes global-heading-gradient-sweep {
  0% {
    background-position: 110% 50%;
  }
  48% {
    background-position: 0% 50%;
  }
  100% {
    background-position: -110% 50%;
  }
}

@keyframes global-button-gradient-sweep {
  0% {
    background-position: 110% 50%;
  }
  50% {
    background-position: 0% 50%;
  }
  100% {
    background-position: -110% 50%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .app-shell .hero-copy h1,
  .app-shell .hero-copy h1 span,
  .app-shell .section-heading h2,
  .app-shell .service-lead-card h3,
  .app-shell .premium-service-card h3,
  .app-shell .showroom-copy h2,
  .app-shell .theme-card h3,
  .app-shell .reference-section h2,
  .app-shell .contact-section h2,
  .app-shell .hero-brandline span,
  .app-shell .premium-service-card small,
  .app-shell .service-lead-topline span,
  .app-shell .section-heading span,
  .app-shell .showroom-copy span,
  .app-shell .reference-section span,
  .app-shell .contact-section span,
  .app-shell .theme-card strong,
  .app-shell .hub-card span,
  .app-shell .step-item span,
  .primary-action {
    animation: none !important;
    background-position: 50% 50% !important;
  }
}


/* CES-BUILD-021: Gradient Typography Repair
   Fixes:
   - Kein Gradient-Balken mehr im Hero.
   - Globale Headlines nutzen klar aktuelle Akzentfarbe -> nächste Akzentfarbe.
   - Keine dominante Weiß-/Hellfläche mehr.
   - ServiceFlow-Sweep bleibt unangetastet.
*/

/* Erst grobe BUILD-020-Hero-Regel neutralisieren, die den Balken erzeugt hat. */
.app-shell .hero-copy h1,
.app-shell .hero-copy h1 span {
  background: none !important;
  background-image: none !important;
  -webkit-background-clip: initial !important;
  background-clip: initial !important;
  color: inherit !important;
  -webkit-text-fill-color: currentColor !important;
  animation: none !important;
  filter: none !important;
}

/* Hero bekommt sichere Inline-Gradient-Lines statt Block-Background. */
.hero-gradient-title {
  display: grid !important;
  gap: 0.08em;
  max-width: 60rem;
  overflow: visible !important;
}

.hero-gradient-title .gradient-title-line {
  display: inline-block !important;
  width: fit-content;
  max-width: 100%;
  padding-bottom: 0.12em;
  overflow: visible !important;
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-main) 36%,
      var(--pulse-next-main) 72%,
      var(--pulse-next-main) 100%
    ) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  filter:
    drop-shadow(0 0 12px rgba(var(--pulse-rgb), 0.18))
    drop-shadow(0 0 18px rgba(var(--pulse-next-rgb), 0.10));
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Die zweite Zeile darf stärker die nächste Farbe zeigen. */
.hero-gradient-title .gradient-title-line:nth-child(2) {
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 54%,
      var(--pulse-next-main) 100%
    ) !important;
}

/* Globale Überschriften: klarer 2-Farben-Verlauf statt hell/dunkel einer Farbe. */
.app-shell .section-heading h2,
.app-shell .service-lead-card h3,
.app-shell .premium-service-card h3,
.app-shell .showroom-copy h2,
.app-shell .theme-card h3,
.app-shell .reference-section h2,
.app-shell .contact-section h2 {
  display: inline-block;
  width: fit-content;
  max-width: 100%;
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-main) 34%,
      var(--pulse-next-main) 70%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  animation: none !important;
  filter:
    drop-shadow(0 0 10px rgba(var(--pulse-rgb), 0.13))
    drop-shadow(0 0 16px rgba(var(--pulse-next-rgb), 0.08));
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Kleine Card-Titel etwas ruhiger, aber weiterhin Current -> Next. */
.app-shell .premium-service-card h3,
.app-shell .theme-card h3 {
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 82%,
      var(--pulse-next-main) 100%
    ) !important;
  filter:
    drop-shadow(0 0 8px rgba(var(--pulse-rgb), 0.12))
    drop-shadow(0 0 12px rgba(var(--pulse-next-rgb), 0.06));
}

/* Kicker/Akzente: keine weißen Flächen, klarer Current/Next-Verlauf. */
.app-shell .hero-brandline span,
.app-shell .premium-service-card small,
.app-shell .service-lead-topline span,
.app-shell .section-heading span,
.app-shell .showroom-copy span,
.app-shell .reference-section span,
.app-shell .contact-section span,
.app-shell .theme-card strong,
.app-shell .hub-card span,
.app-shell .step-item span {
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  animation: none !important;
  filter: drop-shadow(0 0 9px rgba(var(--pulse-rgb), 0.16));
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Pill-Buttons/Badges behalten ihren Hintergrund, nur Text-Clip nicht auf ganze Box anwenden. */
.app-shell .eyebrow {
  color: var(--pulse-main) !important;
  -webkit-text-fill-color: currentColor !important;
}

/* Primary-Button darf weiterhin farbig sein, aber ohne weißen Flächenanteil. */
.primary-action {
  background:
    linear-gradient(
      135deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 58%,
      var(--pulse-main) 100%
    ) !important;
  background-size: 180% 100% !important;
}

/* Sicherstellen, dass Descender wie g weiterhin nicht abgeschnitten werden. */
.hero-gradient-title,
.hero-gradient-title .gradient-title-line,
.app-shell .section-heading h2,
.app-shell .service-lead-card h3,
.app-shell .showroom-copy h2,
.app-shell .reference-section h2,
.app-shell .contact-section h2 {
  overflow: visible !important;
  padding-bottom: 0.08em;
}


/* CES-BUILD-022: Gradient Balken Fix
   Fix für Elemente, bei denen der Gradient als Fläche statt als Textclip angezeigt wurde.
   Große Headlines behalten den schönen Current -> Next Gradient.
*/

/* Hero-Headline: sichere Text-Gradient-Zeilen ohne Hintergrundbalken */
.hero-gradient-title,
.hero-gradient-title .gradient-title-line {
  background: none !important;
  background-color: transparent !important;
  box-shadow: none !important;
}

.hero-gradient-title .gradient-title-line,
.hero-gradient-title .gradient-title-line:nth-child(2) {
  display: inline-block !important;
  width: fit-content !important;
  max-width: 100% !important;
  background-image:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-main) 34%,
      var(--pulse-next-main) 72%,
      var(--pulse-next-main) 100%
    ) !important;
  background-color: transparent !important;
  background-size: 100% 100% !important;
  background-repeat: no-repeat !important;
  background-position: 0 50% !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  filter:
    drop-shadow(0 0 12px rgba(var(--pulse-rgb), 0.18))
    drop-shadow(0 0 18px rgba(var(--pulse-next-rgb), 0.10));
}

/* Die zweite Hero-Zeile darf etwas stärker Richtung nächste Farbe laufen, aber ohne Flächen-Balken. */
.hero-gradient-title .gradient-title-line:nth-child(2) {
  background-image:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 50%,
      var(--pulse-next-main) 100%
    ) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
}

/* Kleine Kicker/Labels wieder als Text statt Gradient-Flächen anzeigen.
   Diese waren die Hauptursache für die kleinen farbigen Balken in den Cards. */
.app-shell .premium-service-card small,
.app-shell .service-lead-topline span,
.app-shell .section-heading span,
.app-shell .showroom-copy span,
.app-shell .reference-section span,
.app-shell .contact-section span,
.app-shell .theme-card strong,
.app-shell .hub-card span,
.app-shell .step-item span {
  background: none !important;
  background-image: none !important;
  -webkit-background-clip: initial !important;
  background-clip: initial !important;
  color: var(--pulse-main) !important;
  -webkit-text-fill-color: var(--pulse-main) !important;
  filter: drop-shadow(0 0 8px rgba(var(--pulse-rgb), 0.18)) !important;
  animation: none !important;
  transition:
    color 4.5s ease,
    -webkit-text-fill-color 4.5s ease,
    filter 4.5s ease,
    border-color 4.5s ease,
    background-color 4.5s ease;
}

/* Pills/Badges behalten ihre eigene Glasfläche, aber ohne Textclip-Balken. */
.app-shell .section-heading span,
.app-shell .showroom-copy span,
.app-shell .reference-section span,
.app-shell .contact-section span,
.app-shell .service-lead-topline span {
  background-color: rgba(var(--pulse-rgb), 0.09) !important;
  border-color: rgba(var(--pulse-rgb), 0.24) !important;
}

/* Service-Card Kicker bewusst ohne Pill-Fläche, nur leuchtender Text. */
.app-shell .premium-service-card small {
  background-color: transparent !important;
}

/* Große Headlines: nochmals sicherstellen, dass nur der Text selbst clipped wird. */
.app-shell .section-heading h2,
.app-shell .service-lead-card h3,
.app-shell .premium-service-card h3,
.app-shell .showroom-copy h2,
.app-shell .theme-card h3,
.app-shell .reference-section h2,
.app-shell .contact-section h2 {
  background-color: transparent !important;
  background-repeat: no-repeat !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
}

/* Falls Browser bei background-shorthand zickt: Force Text Fill nach allen Regeln. */
.app-shell .section-heading h2,
.app-shell .service-lead-card h3,
.app-shell .premium-service-card h3,
.app-shell .showroom-copy h2,
.app-shell .theme-card h3,
.app-shell .reference-section h2,
.app-shell .contact-section h2,
.hero-gradient-title .gradient-title-line {
  -webkit-text-fill-color: transparent !important;
}


/* CES-BUILD-023: Gradient Descender Final Fix
   Fix:
   - Erste Hero-Zeile "Digitale Auftritte" bekommt wieder den Gradient.
   - Descender wie g werden bei allen großen Headlines nicht mehr abgeschnitten.
*/

/* Spezifischer als die frühere Reset-Regel aus BUILD-021/022 */
.app-shell .hero-copy h1.hero-gradient-title span.gradient-title-line,
.app-shell .hero-copy h1.hero-gradient-title span.gradient-title-line:nth-child(2) {
  display: inline-block !important;
  width: fit-content !important;
  max-width: 100% !important;
  line-height: 1.16 !important;
  padding-top: 0.02em !important;
  padding-bottom: 0.22em !important;
  overflow: visible !important;
  background-color: transparent !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  filter:
    drop-shadow(0 0 12px rgba(var(--pulse-rgb), 0.18))
    drop-shadow(0 0 18px rgba(var(--pulse-next-rgb), 0.10)) !important;
}

.app-shell .hero-copy h1.hero-gradient-title span.gradient-title-line {
  background-image:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-main) 32%,
      var(--pulse-next-main) 72%,
      var(--pulse-next-main) 100%
    ) !important;
}

.app-shell .hero-copy h1.hero-gradient-title span.gradient-title-line:nth-child(2) {
  background-image:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 54%,
      var(--pulse-next-main) 100%
    ) !important;
}

/* Alle großen Gradients bekommen mehr Unterlängen-Luft. */
.app-shell .section-heading h2,
.app-shell .showroom-copy h2,
.app-shell .reference-section h2,
.app-shell .contact-section h2,
.app-shell .service-lead-card h3,
.app-shell .premium-service-card h3,
.app-shell .theme-card h3 {
  line-height: 1.16 !important;
  padding-top: 0.02em !important;
  padding-bottom: 0.24em !important;
  overflow: visible !important;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

/* Parent-Container dürfen den unteren Teil nicht abschneiden. */
.app-shell .section-heading,
.app-shell .showroom-copy,
.app-shell .reference-section,
.app-shell .contact-section,
.app-shell .service-lead-card,
.app-shell .premium-service-card,
.app-shell .theme-card,
.app-shell .services-section,
.app-shell .showroom-section {
  overflow: visible !important;
}

/* Besonders für lange mehrzeilige Headlines wie Showroom/Ablauf/Kontakt. */
.app-shell .showroom-copy h2,
.app-shell .section-heading h2,
.app-shell .reference-section h2,
.app-shell .contact-section h2 {
  margin-bottom: 0.18rem !important;
}

/* Kleine Karten-Titel sollen nicht riesige Abstände bekommen. */
.app-shell .premium-service-card h3,
.app-shell .theme-card h3 {
  padding-bottom: 0.14em !important;
  line-height: 1.18 !important;
}

/* Flow-Visual bleibt beim gewünschten Sweep, bekommt aber safe Descender-Luft. */
.refined-flow-core span,
.refined-flow-core strong,
.refined-flow-core small,
.flow-node span,
.flow-node strong {
  line-height: 1.14 !important;
  padding-bottom: 0.04em !important;
  overflow: visible !important;
}


/* CES-BUILD-024: Showroom Section Upgrade
   Wichtig: Keine Änderungen an den globalen Gradient-Regeln aus BUILD-023.
   Dieser Block betrifft nur den CoreHub-/Showroom-Bereich.
*/
.showroom-upgrade {
  align-items: stretch;
  gap: clamp(2rem, 4vw, 5rem);
  padding-top: clamp(4rem, 6vw, 7.5rem);
  padding-bottom: clamp(4rem, 6vw, 7.5rem);
}

.showroom-copy-upgrade {
  align-self: center;
}

.showroom-copy-upgrade p {
  max-width: 44rem;
}

.showroom-proof-list {
  display: grid;
  gap: 0.75rem;
  margin-top: 1.8rem;
  max-width: 43rem;
}

.showroom-proof-list article {
  position: relative;
  border: 1px solid rgba(var(--pulse-rgb), 0.14);
  border-radius: 1.15rem;
  padding: 0.95rem 1rem 0.95rem 1.15rem;
  overflow: hidden;
  background:
    radial-gradient(circle at 0% 0%, rgba(var(--pulse-rgb), 0.11), transparent 8rem),
    rgba(255, 255, 255, 0.025);
  backdrop-filter: blur(14px);
  transition:
    border-color 4.5s ease,
    background 4.5s ease,
    transform 180ms ease,
    box-shadow 4.5s ease;
}

.showroom-proof-list article::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.9rem;
  bottom: 0.9rem;
  width: 2px;
  border-radius: 999px;
  background: linear-gradient(var(--pulse-main), var(--pulse-next-main));
  box-shadow: 0 0 16px rgba(var(--pulse-rgb), 0.28);
  transition: background 4.5s ease, box-shadow 4.5s ease;
}

.showroom-proof-list article:hover {
  transform: translateX(4px);
  border-color: rgba(var(--pulse-rgb), 0.26);
  box-shadow: 0 18px 55px rgba(var(--pulse-rgb), 0.055);
}

.showroom-proof-list strong {
  display: block;
  color: var(--pulse-main);
  font-size: 0.9rem;
  font-weight: 950;
  letter-spacing: -0.015em;
  transition: color 4.5s ease;
}

.showroom-proof-list p {
  margin: 0.32rem 0 0;
  color: rgba(230, 244, 224, 0.72);
  font-size: 0.86rem;
  line-height: 1.55;
}

.corehub-panel {
  position: relative;
  min-height: 34rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.16);
  border-radius: 1.8rem;
  padding: clamp(1rem, 1.8vw, 1.45rem);
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 12%, rgba(var(--pulse-rgb), 0.12), transparent 20rem),
    linear-gradient(145deg, rgba(255, 255, 255, 0.045), transparent 58%),
    rgba(7, 15, 8, 0.56);
  box-shadow:
    inset 0 0 52px rgba(var(--pulse-rgb), 0.035),
    0 28px 100px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(18px);
  transition:
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.corehub-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.22;
  background-image:
    linear-gradient(rgba(var(--pulse-rgb), 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--pulse-rgb), 0.055) 1px, transparent 1px);
  background-size: 38px 38px;
  mask-image: radial-gradient(circle at 50% 32%, #000 0%, transparent 72%);
  pointer-events: none;
  transition: background-image 4.5s ease;
}

.corehub-panel-head {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: flex-start;
  margin-bottom: 1.15rem;
}

.corehub-panel-head div {
  display: grid;
  gap: 0.25rem;
}

.corehub-panel-head span {
  color: var(--pulse-main);
  font-size: 0.78rem;
  font-weight: 950;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: color 4.5s ease;
}

.corehub-panel-head strong {
  color: rgba(245, 255, 240, 0.94);
  font-size: clamp(1.2rem, 1.6vw, 1.55rem);
  letter-spacing: -0.045em;
}

.corehub-panel-head p {
  max-width: 15rem;
  margin: 0;
  color: rgba(230, 244, 224, 0.62);
  font-size: 0.82rem;
  line-height: 1.5;
  text-align: right;
}

.corehub-map {
  position: relative;
  z-index: 2;
  min-height: 11rem;
  margin: 0 0 1.15rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.1);
  border-radius: 1.35rem;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 50%, rgba(var(--pulse-rgb), 0.15), transparent 12rem),
    rgba(0, 0, 0, 0.13);
  transition:
    border-color 4.5s ease,
    background 4.5s ease;
}

.corehub-core {
  position: absolute;
  left: 50%;
  top: 50%;
  display: grid;
  place-items: center;
  width: 6.2rem;
  height: 6.2rem;
  transform: translate(-50%, -50%);
  border: 1px solid rgba(var(--pulse-rgb), 0.32);
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 25%, rgba(var(--pulse-next-rgb), 0.18), transparent 24%),
    radial-gradient(circle at 50% 50%, rgba(var(--pulse-rgb), 0.3), rgba(0,0,0,0.18) 68%);
  box-shadow:
    0 0 32px rgba(var(--pulse-rgb), 0.22),
    0 0 48px rgba(var(--pulse-next-rgb), 0.10),
    inset -10px -12px 20px rgba(0,0,0,0.32);
  animation: corehub-breathe 5.6s ease-in-out infinite;
  transition:
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.corehub-core span {
  margin-top: 0.7rem;
  color: var(--pulse-main);
  font-size: 0.62rem;
  font-weight: 950;
  letter-spacing: 0.22em;
  transition: color 4.5s ease;
}

.corehub-core strong {
  margin-top: -1.2rem;
  color: rgba(245, 255, 240, 0.96);
  font-size: 1.18rem;
  font-weight: 950;
  letter-spacing: 0.03em;
}

.hub-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44%;
  height: 1px;
  transform-origin: left center;
  background:
    linear-gradient(90deg, transparent, rgba(var(--pulse-rgb), 0.45), rgba(var(--pulse-next-rgb), 0.26), transparent);
  box-shadow:
    0 0 12px rgba(var(--pulse-rgb), 0.16),
    0 0 20px rgba(var(--pulse-next-rgb), 0.08);
  transition: background 4.5s ease, box-shadow 4.5s ease;
}

.hub-line-one {
  transform: rotate(0deg);
}

.hub-line-two {
  transform: rotate(120deg);
}

.hub-line-three {
  transform: rotate(240deg);
}

.hub-pulse {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0.54rem;
  height: 0.54rem;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--pulse-main), var(--pulse-next-main));
  box-shadow:
    0 0 14px rgba(var(--pulse-rgb), 0.64),
    0 0 28px rgba(var(--pulse-next-rgb), 0.22);
  transition: background 4.5s ease, box-shadow 4.5s ease;
}

.hub-pulse-one {
  animation: corehub-route-one 6s ease-in-out infinite;
}

.hub-pulse-two {
  animation: corehub-route-two 6.8s ease-in-out infinite 0.7s;
}

.hub-pulse-three {
  animation: corehub-route-three 7.3s ease-in-out infinite 1.2s;
}

.hub-preview-upgrade {
  position: relative;
  z-index: 2;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.75rem;
}

.hub-preview-upgrade .hub-card {
  position: relative;
  min-height: 9.4rem;
  padding: 0.95rem;
  overflow: hidden;
  background:
    radial-gradient(circle at 0% 0%, rgba(var(--pulse-rgb), 0.12), transparent 7.5rem),
    rgba(255, 255, 255, 0.026);
  transition:
    transform 180ms ease,
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.hub-preview-upgrade .hub-card:hover {
  transform: translateY(-4px);
  border-color: rgba(var(--pulse-rgb), 0.28);
  box-shadow: 0 20px 65px rgba(var(--pulse-rgb), 0.07);
}

.hub-preview-upgrade .hub-card.active {
  border-color: rgba(var(--pulse-rgb), 0.42);
  box-shadow:
    0 0 0 1px rgba(var(--pulse-rgb), 0.04),
    0 24px 70px rgba(var(--pulse-rgb), 0.08);
}

.hub-preview-upgrade .hub-card.active::after {
  content: "aktiv";
  position: absolute;
  right: 0.8rem;
  bottom: 0.72rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.24);
  border-radius: 999px;
  padding: 0.24rem 0.48rem;
  color: var(--pulse-main);
  background: rgba(var(--pulse-rgb), 0.08);
  font-size: 0.62rem;
  font-weight: 950;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  transition: color 4.5s ease, border-color 4.5s ease, background 4.5s ease;
}

.hub-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
  margin-bottom: 0.72rem;
}

.hub-card-icon {
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.2);
  border-radius: 0.7rem;
  color: var(--pulse-main);
  background: rgba(var(--pulse-rgb), 0.07);
  transition: color 4.5s ease, border-color 4.5s ease, background 4.5s ease;
}

.hub-preview-upgrade .hub-card h3 {
  margin: 0;
  color: rgba(245, 255, 240, 0.95);
  font-size: 1.08rem;
  letter-spacing: -0.04em;
}

.hub-preview-upgrade .hub-card p {
  min-height: 2.6rem;
  margin: 0.5rem 0 0;
  color: rgba(230, 244, 224, 0.64);
  font-size: 0.78rem;
  line-height: 1.45;
}

.hub-preview-upgrade .hub-card small {
  display: inline-flex;
  margin-top: 0.85rem;
  color: var(--pulse-main);
  font-size: 0.72rem;
  font-weight: 850;
  transition: color 4.5s ease;
}

.showroom-note-upgrade {
  position: relative;
  z-index: 2;
  margin: 1rem 0 0;
  border-left: 2px solid rgba(var(--pulse-rgb), 0.42);
  padding-left: 0.9rem;
  color: rgba(230, 244, 224, 0.68);
  font-size: 0.86rem;
  line-height: 1.6;
  transition: border-color 4.5s ease;
}

@keyframes corehub-breathe {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.035);
  }
}

@keyframes corehub-route-one {
  0%, 100% {
    transform: translate(-0.27rem, -0.27rem) scale(0.7);
    opacity: 0.34;
  }
  50% {
    transform: translate(15rem, -0.27rem) scale(1.05);
    opacity: 1;
  }
}

@keyframes corehub-route-two {
  0%, 100% {
    transform: translate(-0.27rem, -0.27rem) scale(0.7);
    opacity: 0.34;
  }
  50% {
    transform: translate(-8.4rem, 9rem) scale(1.05);
    opacity: 1;
  }
}

@keyframes corehub-route-three {
  0%, 100% {
    transform: translate(-0.27rem, -0.27rem) scale(0.7);
    opacity: 0.34;
  }
  50% {
    transform: translate(-8.4rem, -9rem) scale(1.05);
    opacity: 1;
  }
}

@media (max-width: 1180px) {
  .showroom-upgrade {
    grid-template-columns: 1fr;
  }

  .corehub-panel-head p {
    text-align: left;
  }
}

@media (max-width: 860px) {
  .hub-preview-upgrade {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .corehub-panel-head {
    flex-direction: column;
  }
}

@media (max-width: 620px) {
  .hub-preview-upgrade {
    grid-template-columns: 1fr;
  }

  .corehub-map {
    min-height: 9rem;
  }

  .corehub-core {
    width: 5.2rem;
    height: 5.2rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .corehub-core,
  .hub-pulse {
    animation: none !important;
  }
}


/* CES-BUILD-025: Compact Layout Polish
   Ziel:
   - 100% Browserzoom soll näher am bisherigen 80%-Gefühl liegen.
   - Große Leistungen-Headline wird entfernt, weil sie die Anordnung sprengt.
   - CoreHub "HUB" bekommt Farbverlauf statt Weiß.
   - Keine Änderungen an MatrixRain, SmoothPulse, HeroCube oder ServiceFlow-Logik.
*/

/* Allgemein etwas kompakter, ohne den Look zu verlieren. */
.full-bleed-section {
  padding-left: clamp(2rem, 3vw, 3.6rem) !important;
  padding-right: clamp(2rem, 3vw, 3.6rem) !important;
}

.section-block {
  padding-top: clamp(3rem, 4.4vw, 5.6rem) !important;
  padding-bottom: clamp(3rem, 4.4vw, 5.6rem) !important;
}

/* Leistungen-Überschrift entfernen: die große Headline ist an dieser Stelle zu dominant. */
.services-section {
  padding-top: clamp(1.8rem, 3vw, 3.4rem) !important;
}

.services-section > .services-heading {
  display: none !important;
}

.services-layout {
  margin-top: 0 !important;
  grid-template-columns: minmax(19rem, 0.74fr) minmax(0, 1.26fr);
  gap: clamp(0.8rem, 1.2vw, 1.1rem);
}

/* Service-Bereich etwas niedriger/kompakter. */
.service-lead-card {
  padding: clamp(1rem, 1.45vw, 1.45rem) !important;
}

.service-lead-card h3 {
  max-width: 28rem;
  font-size: clamp(1.85rem, 2.55vw, 2.85rem) !important;
  line-height: 1.05 !important;
}

.service-lead-card p {
  line-height: 1.6;
}

.service-lead-flow {
  margin-top: 1.45rem !important;
}

.service-engine-visual {
  min-height: clamp(15.5rem, 20vw, 20.5rem) !important;
  margin-top: 1.15rem !important;
}

.premium-service-card {
  min-height: 15.8rem !important;
  padding: 1rem !important;
}

.premium-service-card h3 {
  font-size: clamp(1.08rem, 1.35vw, 1.42rem) !important;
}

.premium-service-card p {
  font-size: 0.88rem;
  line-height: 1.55;
}

.premium-service-card ul {
  margin-top: 0.8rem !important;
}

.premium-service-card li {
  font-size: 0.78rem;
}

/* Hero ebenfalls minimal kompakter, damit 100% nicht so wuchtig wirkt. */
.hero-section {
  min-height: calc(100vh - 4.8rem);
  padding-top: clamp(2rem, 3.2vw, 4rem) !important;
  padding-bottom: clamp(2.2rem, 3.4vw, 4.2rem) !important;
}

.premium-hero-copy h1 {
  font-size: clamp(2.85rem, 4.25vw, 5.25rem) !important;
  line-height: 1.08 !important;
}

.hero-gradient-title .gradient-title-line,
.app-shell .hero-copy h1.hero-gradient-title span.gradient-title-line,
.app-shell .hero-copy h1.hero-gradient-title span.gradient-title-line:nth-child(2) {
  padding-bottom: 0.18em !important;
}

.hero-lead {
  font-size: clamp(0.92rem, 1vw, 1.04rem) !important;
  max-width: 42rem !important;
}

.hero-module-strip {
  max-width: 42rem !important;
  gap: 0.7rem !important;
}

.hero-module-strip article {
  min-height: 6.35rem !important;
  padding: 0.82rem !important;
}

.hero-engine-stage {
  min-height: 42rem !important;
}

.hero-showcase-cube {
  width: min(100%, 39rem) !important;
}

/* Showroom-Bereich kompakter, aber Upgrade-Look behalten. */
.showroom-upgrade {
  padding-top: clamp(3rem, 4.8vw, 5.8rem) !important;
  padding-bottom: clamp(3rem, 4.8vw, 5.8rem) !important;
}

.showroom-copy-upgrade h2,
.app-shell .showroom-copy h2 {
  font-size: clamp(2.35rem, 4vw, 4.75rem) !important;
  line-height: 1.08 !important;
}

.corehub-panel {
  min-height: 30rem !important;
}

.corehub-map {
  min-height: 9.2rem !important;
}

.corehub-core {
  width: 5.6rem !important;
  height: 5.6rem !important;
}

/* CoreHub: HUB nicht mehr weiß, sondern Current/Next-Gradient. */
.corehub-core strong {
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 72%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  filter:
    drop-shadow(0 0 10px rgba(var(--pulse-rgb), 0.28))
    drop-shadow(0 0 16px rgba(var(--pulse-next-rgb), 0.14));
  transition: background 4.5s ease, filter 4.5s ease;
}

/* Restliche große Bereiche leicht reduzieren. */
.app-shell .section-heading h2,
.app-shell .reference-section h2,
.app-shell .contact-section h2 {
  font-size: clamp(2.25rem, 4vw, 4.65rem) !important;
  line-height: 1.08 !important;
}

.theme-card,
.reference-grid article,
.step-item,
.hub-card {
  border-radius: 1.25rem;
}

/* Auf kleineren Screens wieder normal stacken. */
@media (max-width: 1180px) {
  .services-layout {
    grid-template-columns: 1fr;
  }

  .service-engine-visual {
    min-height: 20rem !important;
  }

  .hero-engine-stage {
    min-height: 34rem !important;
  }
}

@media (max-width: 760px) {
  .full-bleed-section {
    padding-left: 1.1rem !important;
    padding-right: 1.1rem !important;
  }

  .premium-hero-copy h1 {
    font-size: clamp(2.45rem, 10vw, 4.2rem) !important;
  }

  .hero-module-strip {
    grid-template-columns: 1fr;
  }
}


/* CES-BUILD-026: CoreHub Card Gradient Match
   Ziel:
   - CoreHub-Kartentitel im Showroom bekommen denselben Current/Next-Farbverlauf
     wie die Service-Kartentitel im Leistungen-Bereich.
   - Keine Änderungen an MatrixRain, SmoothPulse, HeroCube, ServiceFlow oder globalen Gradient-Regeln.
*/

/* CoreHub-Kartentitel: Webseiten / Systeme / Portale / Tools / Automation / Design */
.hub-preview-upgrade .hub-card h3 {
  display: inline-block !important;
  width: fit-content !important;
  max-width: 100% !important;
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-main) 28%,
      var(--pulse-next-main) 72%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  background-repeat: no-repeat !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  filter:
    drop-shadow(0 0 8px rgba(var(--pulse-rgb), 0.14))
    drop-shadow(0 0 12px rgba(var(--pulse-next-rgb), 0.08)) !important;
  line-height: 1.14 !important;
  padding-bottom: 0.08em !important;
  overflow: visible !important;
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Detail-Zeile darunter nur dezent angleichen, damit sie nicht zu laut wird. */
.hub-preview-upgrade .hub-card small {
  display: inline-flex !important;
  width: fit-content !important;
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  background-repeat: no-repeat !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  filter:
    drop-shadow(0 0 7px rgba(var(--pulse-rgb), 0.16))
    drop-shadow(0 0 10px rgba(var(--pulse-next-rgb), 0.06)) !important;
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Nummern und Icons bleiben smooth einfarbig, damit der Bereich nicht zu bunt wird. */
.hub-preview-upgrade .hub-card-top > span,
.hub-card-icon {
  color: var(--pulse-main) !important;
  transition:
    color 4.5s ease,
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}


/* CES-BUILD-027: WebCube Theme Card Polish
   Sehr enger Patch:
   - Nur der Webseiten-Cube / sechs Richtungen Bereich wird optisch poliert.
   - Keine Größen-/Layoutänderung an Hero, Services, CoreHub, MatrixRain, SmoothPulse oder ServiceFlow.
   - Karten wirken mehr wie vorbereitete Cube-Faces / spätere Template-Slots.
*/

/* Theme-Karten bekommen mehr Tiefe, ohne Grid/Größe zu ändern. */
.theme-grid .theme-card {
  position: relative;
  overflow: hidden;
  border-color: rgba(var(--pulse-rgb), 0.18) !important;
  background:
    radial-gradient(circle at 9% 0%, rgba(var(--pulse-rgb), 0.13), transparent 9rem),
    radial-gradient(circle at 90% 100%, rgba(var(--pulse-next-rgb), 0.08), transparent 10rem),
    linear-gradient(145deg, rgba(255, 255, 255, 0.038), transparent 58%),
    rgba(7, 15, 8, 0.58) !important;
  box-shadow:
    inset 0 0 34px rgba(var(--pulse-rgb), 0.025),
    0 20px 70px rgba(0, 0, 0, 0.18);
  transition:
    transform 180ms ease,
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.theme-grid .theme-card::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.16;
  background-image:
    linear-gradient(rgba(var(--pulse-rgb), 0.09) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--pulse-rgb), 0.09) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: linear-gradient(135deg, #000 0%, transparent 68%);
  pointer-events: none;
  transition: background-image 4.5s ease, opacity 180ms ease;
}

.theme-grid .theme-card::after {
  content: "CUBE FACE";
  position: absolute;
  right: 1rem;
  bottom: 0.88rem;
  color: rgba(230, 244, 224, 0.16);
  font-size: 0.66rem;
  font-weight: 950;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  pointer-events: none;
  transition: color 4.5s ease;
}

.theme-grid .theme-card:hover {
  transform: translateY(-4px);
  border-color: rgba(var(--pulse-rgb), 0.32) !important;
  box-shadow:
    inset 0 0 38px rgba(var(--pulse-rgb), 0.04),
    0 24px 75px rgba(var(--pulse-rgb), 0.075);
}

.theme-grid .theme-card:hover::before {
  opacity: 0.22;
}

.theme-grid .theme-card:hover::after {
  color: rgba(var(--pulse-rgb), 0.32);
}

/* Icon-Kachel passend zum aktiven Puls. */
.theme-grid .theme-icon {
  border-color: rgba(var(--pulse-rgb), 0.24) !important;
  color: var(--pulse-main) !important;
  background:
    radial-gradient(circle at 30% 20%, rgba(var(--pulse-next-rgb), 0.14), transparent 55%),
    rgba(var(--pulse-rgb), 0.08) !important;
  box-shadow:
    0 0 18px rgba(var(--pulse-rgb), 0.12),
    inset 0 0 16px rgba(var(--pulse-next-rgb), 0.055);
  transition:
    color 4.5s ease,
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

/* Rechte Ton-Zeile oben bleibt klein, bekommt aber den aktiven Farbkontext. */
.theme-grid .theme-head span {
  display: inline-block;
  width: fit-content;
  margin-left: auto;
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  background-repeat: no-repeat !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  filter:
    drop-shadow(0 0 7px rgba(var(--pulse-rgb), 0.12))
    drop-shadow(0 0 10px rgba(var(--pulse-next-rgb), 0.055));
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Haupttitel der sechs Richtungen: gleicher Current/Next-Verlauf wie oben bei Services/CoreHub. */
.theme-grid .theme-card h3 {
  display: inline-block !important;
  width: fit-content !important;
  max-width: 100% !important;
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-main) 30%,
      var(--pulse-next-main) 74%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  background-repeat: no-repeat !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  filter:
    drop-shadow(0 0 8px rgba(var(--pulse-rgb), 0.14))
    drop-shadow(0 0 13px rgba(var(--pulse-next-rgb), 0.075)) !important;
  line-height: 1.14 !important;
  padding-bottom: 0.08em !important;
  overflow: visible !important;
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Label unter dem Titel ebenfalls aktivieren, aber etwas ruhiger. */
.theme-grid .theme-card strong {
  display: inline-block !important;
  width: fit-content !important;
  max-width: 100% !important;
  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  background-repeat: no-repeat !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  filter:
    drop-shadow(0 0 7px rgba(var(--pulse-rgb), 0.14))
    drop-shadow(0 0 10px rgba(var(--pulse-next-rgb), 0.055)) !important;
  line-height: 1.18 !important;
  padding-bottom: 0.04em !important;
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Text bleibt ruhig lesbar. */
.theme-grid .theme-card p {
  position: relative;
  z-index: 2;
}

/* Inhalt über Grid-Overlay halten. */
.theme-grid .theme-head,
.theme-grid .theme-card h3,
.theme-grid .theme-card strong,
.theme-grid .theme-card p {
  position: relative;
  z-index: 2;
}


/* CES-BUILD-028: WebCube Gradient Sweep Refinement
   Ziel:
   - Nur Webseiten-Cube-Karten werden verfeinert.
   - Titel und Label kleben nicht mehr zusammen.
   - Kein doppelter Current/Next-Verlauf direkt nebeneinander.
   - Verlauf wirkt länger, ruhiger und mehr wie ein Sweep von rechts nach links.
   - Keine Größen-/Layoutänderung.
*/

/* Titel und Untertitel sauber trennen. */
.theme-grid .theme-card h3 {
  display: block !important;
  width: fit-content !important;
  max-width: 100% !important;
  margin: 0.62rem 0 0.18rem !important;
  line-height: 1.14 !important;
  padding-bottom: 0.08em !important;
  overflow: visible !important;

  background:
    linear-gradient(
      105deg,
      var(--pulse-main) 0%,
      var(--pulse-main) 38%,
      var(--pulse-next-main) 68%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 230% 100% !important;
  background-position: 105% 50% !important;
  background-repeat: no-repeat !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;

  animation: webcube-title-sweep 12s ease-in-out infinite;
  filter:
    drop-shadow(0 0 8px rgba(var(--pulse-rgb), 0.14))
    drop-shadow(0 0 13px rgba(var(--pulse-next-rgb), 0.075)) !important;
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Label nicht nochmal voll als zweiter Verlauf direkt hinter den Titel setzen.
   Es bleibt farbig/lebendig, aber ruhiger und auf eigener Zeile. */
.theme-grid .theme-card strong {
  display: block !important;
  width: fit-content !important;
  max-width: 100% !important;
  margin: 0 0 0.62rem !important;
  line-height: 1.18 !important;
  padding-bottom: 0.04em !important;
  overflow: visible !important;

  background:
    linear-gradient(
      100deg,
      var(--pulse-main) 0%,
      var(--pulse-main) 62%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 180% 100% !important;
  background-position: 100% 50% !important;
  background-repeat: no-repeat !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;

  animation: webcube-label-sweep 14s ease-in-out infinite;
  filter:
    drop-shadow(0 0 7px rgba(var(--pulse-rgb), 0.13))
    drop-shadow(0 0 10px rgba(var(--pulse-next-rgb), 0.045)) !important;
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Top-Label rechts bewusst ruhig halten, damit nicht drei Verläufe gegeneinander laufen. */
.theme-grid .theme-head span {
  background: none !important;
  background-image: none !important;
  -webkit-background-clip: initial !important;
  background-clip: initial !important;
  color: var(--pulse-main) !important;
  -webkit-text-fill-color: var(--pulse-main) !important;
  filter: drop-shadow(0 0 7px rgba(var(--pulse-rgb), 0.12)) !important;
  transition:
    color 4.5s ease,
    -webkit-text-fill-color 4.5s ease,
    filter 4.5s ease;
}

/* Der Bewegungseindruck: kommende Farbe läuft langsam in die aktuelle Schrift hinein. */
@keyframes webcube-title-sweep {
  0% {
    background-position: 112% 50%;
  }
  48% {
    background-position: 18% 50%;
  }
  100% {
    background-position: -72% 50%;
  }
}

@keyframes webcube-label-sweep {
  0% {
    background-position: 105% 50%;
  }
  50% {
    background-position: 35% 50%;
  }
  100% {
    background-position: -45% 50%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .theme-grid .theme-card h3,
  .theme-grid .theme-card strong {
    animation: none !important;
    background-position: 50% 50% !important;
  }
}


/* CES-BUILD-029: WebCube Title Clip Fix
   Fix:
   - Bei WebCube-Kartentiteln wurden letzte Buchstaben abgeschnitten
     z. B. Business Clean, Gaming Matrix, Shopflow, Booking / Rental.
   - Ursache: Gradient/Text-Clip war zu knapp.
   - Nur Webseiten-Cube-Karten betroffen.
   - Keine Größen-/Layoutänderung.
*/

.theme-grid .theme-card h3 {
  display: inline-block !important;
  width: auto !important;
  max-width: calc(100% - 0.2rem) !important;
  min-width: 0 !important;
  padding-right: 0.42em !important;
  padding-left: 0.01em !important;
  padding-bottom: 0.1em !important;
  margin-right: -0.18em !important;
  overflow: visible !important;
  white-space: nowrap !important;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
  contain: none !important;
}

/* Untertitel ebenfalls mit minimaler Sicherheitsluft, damit keine Endbuchstaben wegbrechen. */
.theme-grid .theme-card strong {
  display: inline-block !important;
  width: auto !important;
  max-width: calc(100% - 0.2rem) !important;
  padding-right: 0.34em !important;
  padding-left: 0.01em !important;
  margin-right: -0.14em !important;
  overflow: visible !important;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
  contain: none !important;
}

/* Parent-Inhalte dürfen den Gradient-Text nicht abschneiden. */
.theme-grid .theme-card,
.theme-grid .theme-card *,
.theme-grid .theme-head {
  overflow: visible;
}

/* Aber die Karte selbst behält ihren sauberen Rahmen und versteckt nur große Dekoflächen nicht mehr aggressiv. */
.theme-grid .theme-card {
  overflow: hidden !important;
}

/* Text bleibt über Deko, mit sicherem Renderbereich. */
.theme-grid .theme-card h3,
.theme-grid .theme-card strong {
  position: relative;
  z-index: 3;
}


/* CES-BUILD-030: WebCube Gradient Sequence Fix
   Fix:
   - In den WebCube-Karten gab es optisch A -> B -> A -> B,
     weil Titel und Untertitel jeweils eigene Current/Next-Verläufe hatten.
   - Jetzt:
     Titel = Current -> Next
     Untertitel = kommende Akzentfarbe / Next-Bereich
   - Dadurch wirkt die Zeile wie ein zusammenhängender Verlauf.
   - Keine Größen-/Layoutänderung.
   - Keine Änderung an MatrixRain, SmoothPulse, Hero, Services, CoreHub oder ServiceFlow.
*/

/* Haupttitel bleibt Current -> Next, aber nicht mehr als eigener laufender Sweep. */
.theme-grid .theme-card h3 {
  display: inline-block !important;
  width: auto !important;
  max-width: calc(100% - 0.25rem) !important;
  margin: 0.62rem 0.34rem 0.18rem 0 !important;
  padding-left: 0.01em !important;
  padding-right: 0.42em !important;
  padding-bottom: 0.1em !important;
  line-height: 1.14 !important;
  white-space: nowrap !important;
  overflow: visible !important;

  background:
    linear-gradient(
      90deg,
      var(--pulse-main) 0%,
      var(--pulse-main) 42%,
      var(--pulse-next-main) 100%
    ) !important;
  background-size: 100% 100% !important;
  background-position: 0 50% !important;
  background-repeat: no-repeat !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;

  animation: none !important;
  filter:
    drop-shadow(0 0 8px rgba(var(--pulse-rgb), 0.13))
    drop-shadow(0 0 12px rgba(var(--pulse-next-rgb), 0.075)) !important;
  transition:
    background 4.5s ease,
    filter 4.5s ease;
}

/* Untertitel startet NICHT nochmal bei Current.
   Er bleibt bewusst in der kommenden Akzentfarbe, damit kein A -> B -> A entsteht. */
.theme-grid .theme-card strong {
  display: inline-block !important;
  width: auto !important;
  max-width: calc(100% - 0.25rem) !important;
  margin: 0 0 0.62rem 0 !important;
  padding-left: 0.01em !important;
  padding-right: 0.34em !important;
  padding-bottom: 0.06em !important;
  line-height: 1.18 !important;
  white-space: nowrap !important;
  overflow: visible !important;

  background: none !important;
  background-image: none !important;
  -webkit-background-clip: initial !important;
  background-clip: initial !important;
  color: var(--pulse-next-main) !important;
  -webkit-text-fill-color: var(--pulse-next-main) !important;

  animation: none !important;
  filter:
    drop-shadow(0 0 7px rgba(var(--pulse-next-rgb), 0.18))
    drop-shadow(0 0 11px rgba(var(--pulse-next-rgb), 0.08)) !important;
  transition:
    color 4.5s ease,
    -webkit-text-fill-color 4.5s ease,
    filter 4.5s ease;
}

/* Lange Kombinationen dürfen sauber umbrechen, falls ein Viewport kleiner wird.
   Auf großen Screens bleiben sie in einer ruhigen Zeile. */
@media (max-width: 1050px) {
  .theme-grid .theme-card h3,
  .theme-grid .theme-card strong {
    white-space: normal !important;
  }
}

/* Rechte Ton-Zeile oben bleibt smooth einfarbig, nicht als zweiter Verlauf. */
.theme-grid .theme-head span {
  background: none !important;
  background-image: none !important;
  -webkit-background-clip: initial !important;
  background-clip: initial !important;
  color: var(--pulse-main) !important;
  -webkit-text-fill-color: var(--pulse-main) !important;
  animation: none !important;
  filter: drop-shadow(0 0 7px rgba(var(--pulse-rgb), 0.12)) !important;
  transition:
    color 4.5s ease,
    -webkit-text-fill-color 4.5s ease,
    filter 4.5s ease;
}


/* CES-BUILD-031: Reference CaseCube
   Ziel:
   - Referenzen als eigener CaseCube, nicht als Kopie vom Hero-Cube.
   - Hero, WebCube, ServiceFlow, MatrixRain und globale Gradient-Logik bleiben unangetastet.
   - Nur Referenzen-Bereich wird erweitert.
*/
.reference-case-section {
  align-items: center;
  gap: clamp(1.8rem, 3vw, 3.2rem);
  padding-top: clamp(3.2rem, 5vw, 6.2rem);
  padding-bottom: clamp(3.2rem, 5vw, 6.2rem);
  background:
    radial-gradient(circle at 76% 34%, rgba(var(--pulse-rgb), 0.11), transparent 27rem),
    radial-gradient(circle at 18% 72%, rgba(var(--pulse-next-rgb), 0.075), transparent 24rem),
    rgba(255, 255, 255, 0.01);
  transition: background 4.5s ease;
}

.reference-copy {
  position: relative;
  z-index: 2;
}

.reference-copy p {
  max-width: 42rem;
  margin: 0.95rem 0 0;
  color: rgba(230, 244, 224, 0.68);
  line-height: 1.7;
}

.reference-case-tabs {
  display: grid;
  gap: 0.72rem;
  margin-top: 1.6rem;
  max-width: 43rem;
}

.reference-case-tabs button {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  width: 100%;
  border: 1px solid rgba(var(--pulse-rgb), 0.14);
  border-radius: 1rem;
  padding: 0.82rem 0.95rem;
  color: rgba(245, 255, 240, 0.78);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.035), transparent 62%),
    rgba(7, 15, 8, 0.52);
  cursor: pointer;
  text-align: left;
  transition:
    transform 180ms ease,
    color 4.5s ease,
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.reference-case-tabs button:hover,
.reference-case-tabs button.active {
  transform: translateX(4px);
  border-color: rgba(var(--pulse-rgb), 0.34);
  box-shadow: 0 16px 46px rgba(var(--pulse-rgb), 0.065);
}

.reference-case-tabs button span {
  color: var(--pulse-main);
  font-size: 0.78rem;
  font-weight: 950;
  transition: color 4.5s ease;
}

.reference-case-tabs button strong {
  font-size: 0.92rem;
  font-weight: 950;
  letter-spacing: -0.02em;
}

.reference-showcase-panel {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: minmax(19rem, 0.9fr) minmax(19rem, 1.1fr);
  gap: clamp(1rem, 1.6vw, 1.35rem);
  align-items: stretch;
  border: 1px solid rgba(var(--pulse-rgb), 0.16);
  border-radius: 1.8rem;
  padding: clamp(1rem, 1.65vw, 1.35rem);
  overflow: hidden;
  background:
    radial-gradient(circle at 32% 18%, rgba(var(--pulse-rgb), 0.13), transparent 19rem),
    radial-gradient(circle at 88% 82%, rgba(var(--pulse-next-rgb), 0.075), transparent 18rem),
    linear-gradient(145deg, rgba(255, 255, 255, 0.045), transparent 58%),
    rgba(7, 15, 8, 0.58);
  box-shadow:
    inset 0 0 48px rgba(var(--pulse-rgb), 0.03),
    0 28px 100px rgba(0, 0, 0, 0.26);
  backdrop-filter: blur(18px);
  transition:
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.reference-showcase-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.16;
  background-image:
    linear-gradient(rgba(var(--pulse-rgb), 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--pulse-rgb), 0.07) 1px, transparent 1px);
  background-size: 34px 34px;
  mask-image: radial-gradient(circle at 44% 46%, #000 0%, transparent 74%);
  pointer-events: none;
  transition: background-image 4.5s ease;
}

.reference-cube-stage {
  position: relative;
  z-index: 2;
  display: grid;
  place-items: center;
  min-height: clamp(21rem, 29vw, 31rem);
  perspective: 1200px;
  border: 1px solid rgba(var(--pulse-rgb), 0.11);
  border-radius: 1.35rem;
  background:
    radial-gradient(circle at 50% 50%, rgba(var(--pulse-rgb), 0.12), transparent 13rem),
    rgba(0, 0, 0, 0.12);
  overflow: hidden;
  transition: border-color 4.5s ease, background 4.5s ease;
}

.reference-cube-stage::after {
  content: "CASECUBE";
  position: absolute;
  left: 1rem;
  bottom: 0.9rem;
  color: rgba(230, 244, 224, 0.2);
  font-size: 0.68rem;
  font-weight: 950;
  letter-spacing: 0.18em;
}

.reference-case-cube {
  position: relative;
  width: clamp(14rem, 21vw, 20rem);
  height: clamp(8rem, 12vw, 11.25rem);
  transform-style: preserve-3d;
  transform: var(--case-rotation);
  transition: transform 850ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.case-face {
  position: absolute;
  inset: 0;
  margin: 0;
  border: 1px solid rgba(var(--pulse-rgb), 0.24);
  border-radius: 1rem;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.42);
  box-shadow:
    0 0 24px rgba(var(--pulse-rgb), 0.12),
    0 0 42px rgba(var(--pulse-next-rgb), 0.065),
    inset 0 0 20px rgba(255, 255, 255, 0.035);
  backface-visibility: hidden;
  transition: border-color 4.5s ease, box-shadow 4.5s ease;
}

.case-face img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(0.96) contrast(1.05) brightness(0.76);
}

.case-face::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(0,0,0,0.04), rgba(0,0,0,0.46)),
    radial-gradient(circle at 18% 0%, rgba(var(--pulse-rgb), 0.18), transparent 55%);
  pointer-events: none;
  transition: background 4.5s ease;
}

.case-face figcaption {
  position: absolute;
  left: 0.72rem;
  right: 0.72rem;
  bottom: 0.68rem;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.7rem;
}

.case-face figcaption span {
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.25);
  border-radius: 0.65rem;
  color: var(--pulse-main);
  background: rgba(0, 0, 0, 0.42);
  font-size: 0.72rem;
  font-weight: 950;
  transition: color 4.5s ease, border-color 4.5s ease;
}

.case-face figcaption strong {
  color: rgba(245, 255, 240, 0.94);
  font-size: 0.84rem;
  font-weight: 950;
  text-align: right;
}

.case-face-0 { transform: rotateY(0deg) translateZ(clamp(7rem, 10.5vw, 10rem)); }
.case-face-1 { transform: rotateY(90deg) translateZ(clamp(7rem, 10.5vw, 10rem)); }
.case-face-2 { transform: rotateY(180deg) translateZ(clamp(7rem, 10.5vw, 10rem)); }
.case-face-3 { transform: rotateY(-90deg) translateZ(clamp(7rem, 10.5vw, 10rem)); }

.reference-detail-card {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100%;
  border: 1px solid rgba(var(--pulse-rgb), 0.13);
  border-radius: 1.35rem;
  padding: clamp(1.1rem, 1.7vw, 1.55rem);
  background:
    radial-gradient(circle at 5% 0%, rgba(var(--pulse-rgb), 0.11), transparent 10rem),
    rgba(255, 255, 255, 0.024);
  transition: border-color 4.5s ease, background 4.5s ease;
}

.reference-detail-kicker {
  display: inline-flex;
  align-items: center;
  gap: 0.48rem;
  width: fit-content;
  color: var(--pulse-main);
  font-size: 0.76rem;
  font-weight: 950;
  letter-spacing: 0.045em;
  text-transform: uppercase;
  transition: color 4.5s ease;
}

.reference-detail-card h3 {
  display: inline-block;
  width: fit-content;
  max-width: 100%;
  margin: 0.8rem 0 0.6rem;
  background:
    linear-gradient(90deg, var(--pulse-main) 0%, var(--pulse-main) 35%, var(--pulse-next-main) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  font-size: clamp(1.7rem, 2.4vw, 2.6rem);
  line-height: 1.12;
  letter-spacing: -0.055em;
  padding-bottom: 0.1em;
  transition: background 4.5s ease;
}

.reference-detail-card p {
  margin: 0;
  color: rgba(230, 244, 224, 0.72);
  line-height: 1.7;
  font-size: 0.92rem;
}

.reference-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin-top: 1.2rem;
}

.reference-meta-row span {
  border: 1px solid rgba(var(--pulse-rgb), 0.16);
  border-radius: 999px;
  padding: 0.42rem 0.62rem;
  color: var(--pulse-main);
  background: rgba(var(--pulse-rgb), 0.065);
  font-size: 0.74rem;
  font-weight: 850;
  transition: color 4.5s ease, border-color 4.5s ease, background 4.5s ease;
}

.reference-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 1.4rem;
}

.reference-actions a,
.reference-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.22);
  border-radius: 999px;
  padding: 0.72rem 0.95rem;
  color: rgba(8, 12, 9, 0.96);
  background: linear-gradient(135deg, var(--pulse-main), var(--pulse-next-main));
  font-size: 0.82rem;
  font-weight: 950;
  text-decoration: none;
  box-shadow: 0 15px 42px rgba(var(--pulse-rgb), 0.13);
  cursor: pointer;
  transition: background 4.5s ease, box-shadow 4.5s ease, border-color 4.5s ease;
}

.reference-actions button:disabled {
  color: rgba(230, 244, 224, 0.54);
  background: rgba(255, 255, 255, 0.04);
  cursor: not-allowed;
  box-shadow: none;
}

@media (max-width: 1180px) {
  .reference-case-section,
  .reference-showcase-panel {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .reference-showcase-panel {
    padding: 0.85rem;
  }

  .reference-cube-stage {
    min-height: 18rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .reference-case-cube {
    transition: none !important;
  }
}


/* CES-BUILD-032: Reference Case Viewer
   Ziel:
   - Referenzbilder aktualisieren.
   - CaseCube bleibt bestehen.
   - "Großansicht öffnen" zeigt das ausgewählte Projekt groß und schärfer.
   - Live-Projekte bekommen zusätzlich "Live öffnen".
   - Interne/Beta-Cases bleiben als Preview sichtbar, ohne öffentliche Demo-Links.
   - Keine Änderungen an Hero, WebCube, Services, CoreHub, MatrixRain oder ServiceFlow.
*/

.case-face img {
  filter: saturate(1.02) contrast(1.04) brightness(0.82) !important;
}

.reference-actions {
  flex-wrap: wrap;
}

.reference-actions button:not(:disabled) {
  color: rgba(8, 12, 9, 0.96);
  background: linear-gradient(135deg, var(--pulse-main), var(--pulse-next-main));
  box-shadow: 0 15px 42px rgba(var(--pulse-rgb), 0.13);
}

.reference-detail-kicker::after {
  content: "Case";
  margin-left: 0.15rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.18);
  border-radius: 999px;
  padding: 0.16rem 0.42rem;
  color: var(--pulse-next-main);
  background: rgba(var(--pulse-rgb), 0.055);
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  transition:
    color 4.5s ease,
    border-color 4.5s ease,
    background 4.5s ease;
}

.case-preview-overlay {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  padding: clamp(1rem, 2.2vw, 2rem);
}

.case-preview-backdrop {
  position: absolute;
  inset: 0;
  border: 0;
  padding: 0;
  background:
    radial-gradient(circle at 50% 18%, rgba(var(--pulse-rgb), 0.18), transparent 28rem),
    rgba(0, 0, 0, 0.78);
  backdrop-filter: blur(18px);
  cursor: pointer;
  transition: background 4.5s ease;
}

.case-preview-modal {
  position: relative;
  z-index: 2;
  width: min(96vw, 78rem);
  max-height: min(92vh, 58rem);
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  border: 1px solid rgba(var(--pulse-rgb), 0.22);
  border-radius: 1.55rem;
  overflow: hidden;
  background:
    radial-gradient(circle at 8% 0%, rgba(var(--pulse-rgb), 0.11), transparent 20rem),
    radial-gradient(circle at 90% 110%, rgba(var(--pulse-next-rgb), 0.08), transparent 22rem),
    rgba(6, 13, 8, 0.94);
  box-shadow:
    0 34px 110px rgba(0, 0, 0, 0.58),
    0 0 0 1px rgba(255,255,255,0.035),
    inset 0 0 45px rgba(var(--pulse-rgb), 0.035);
  animation: case-preview-in 180ms ease-out;
  transition:
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.case-preview-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  border-bottom: 1px solid rgba(var(--pulse-rgb), 0.12);
  padding: clamp(1rem, 1.8vw, 1.35rem);
}

.case-preview-head span {
  display: inline-flex;
  width: fit-content;
  border: 1px solid rgba(var(--pulse-rgb), 0.24);
  border-radius: 999px;
  padding: 0.28rem 0.58rem;
  color: var(--pulse-main);
  background: rgba(var(--pulse-rgb), 0.075);
  font-size: 0.72rem;
  font-weight: 950;
  letter-spacing: 0.075em;
  text-transform: uppercase;
  transition:
    color 4.5s ease,
    border-color 4.5s ease,
    background 4.5s ease;
}

.case-preview-head h3 {
  margin: 0.45rem 0 0.18rem;
  background:
    linear-gradient(90deg, var(--pulse-main) 0%, var(--pulse-main) 35%, var(--pulse-next-main) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  font-size: clamp(1.55rem, 2.4vw, 2.45rem);
  line-height: 1.08;
  letter-spacing: -0.055em;
  padding-bottom: 0.08em;
  transition: background 4.5s ease;
}

.case-preview-head p {
  margin: 0;
  color: rgba(230, 244, 224, 0.66);
  font-size: 0.88rem;
}

.case-preview-close {
  display: grid;
  place-items: center;
  width: 2.25rem;
  height: 2.25rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.18);
  border-radius: 0.8rem;
  color: rgba(245, 255, 240, 0.82);
  background: rgba(255, 255, 255, 0.045);
  cursor: pointer;
  font-size: 1.35rem;
  line-height: 1;
  transition:
    color 180ms ease,
    border-color 4.5s ease,
    background 180ms ease;
}

.case-preview-close:hover {
  color: var(--pulse-main);
  background: rgba(var(--pulse-rgb), 0.09);
}

.case-preview-image-wrap {
  min-height: 0;
  padding: clamp(0.75rem, 1.4vw, 1.2rem);
  background:
    linear-gradient(180deg, rgba(255,255,255,0.025), transparent),
    rgba(0, 0, 0, 0.14);
}

.case-preview-image-wrap img {
  width: 100%;
  max-height: min(58vh, 37rem);
  object-fit: contain;
  display: block;
  border: 1px solid rgba(var(--pulse-rgb), 0.16);
  border-radius: 1rem;
  background: rgba(0, 0, 0, 0.32);
  box-shadow:
    0 22px 72px rgba(0, 0, 0, 0.34),
    0 0 38px rgba(var(--pulse-rgb), 0.065);
  transition:
    border-color 4.5s ease,
    box-shadow 4.5s ease;
}

.case-preview-footer {
  border-top: 1px solid rgba(var(--pulse-rgb), 0.12);
  padding: clamp(1rem, 1.7vw, 1.25rem);
}

.case-preview-footer p {
  max-width: 62rem;
  margin: 0;
  color: rgba(230, 244, 224, 0.72);
  line-height: 1.62;
  font-size: 0.9rem;
}

.case-preview-footer .reference-meta-row {
  margin-top: 0.9rem;
}

.case-preview-footer .reference-actions {
  margin-top: 0.95rem;
}

@keyframes case-preview-in {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 760px) {
  .case-preview-modal {
    max-height: 94vh;
    border-radius: 1.1rem;
  }

  .case-preview-head {
    align-items: flex-start;
  }

  .case-preview-image-wrap img {
    max-height: 48vh;
  }
}


/* CES-BUILD-033: Inselleben Preview Gallery
   Ziel:
   - CaseCube bleibt unverändert.
   - Inselleben-Hauptbild bleibt im Cube.
   - Großansicht bekommt für Inselleben mehrere Screenshots als Galerie.
   - Keine Änderungen an Hero, WebCube, Services, CoreHub, MatrixRain oder ServiceFlow.
*/

.case-preview-gallery {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.7rem;
  border-top: 1px solid rgba(var(--pulse-rgb), 0.1);
  padding: 0.75rem clamp(0.75rem, 1.4vw, 1.2rem) 0.95rem;
  background:
    linear-gradient(180deg, rgba(var(--pulse-rgb), 0.035), transparent),
    rgba(0, 0, 0, 0.12);
  transition:
    border-color 4.5s ease,
    background 4.5s ease;
}

.case-preview-gallery button {
  position: relative;
  min-height: 4.4rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.14);
  border-radius: 0.8rem;
  overflow: hidden;
  padding: 0;
  cursor: pointer;
  background: rgba(255, 255, 255, 0.035);
  box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.18);
  transition:
    transform 160ms ease,
    border-color 4.5s ease,
    box-shadow 4.5s ease,
    opacity 160ms ease;
}

.case-preview-gallery button:hover {
  transform: translateY(-2px);
  border-color: rgba(var(--pulse-rgb), 0.34);
  box-shadow:
    0 14px 38px rgba(var(--pulse-rgb), 0.085),
    inset 0 0 24px rgba(0, 0, 0, 0.22);
}

.case-preview-gallery button.active {
  border-color: rgba(var(--pulse-rgb), 0.5);
  box-shadow:
    0 0 0 1px rgba(var(--pulse-rgb), 0.08),
    0 14px 42px rgba(var(--pulse-rgb), 0.12);
}

.case-preview-gallery img {
  width: 100%;
  height: 100%;
  min-height: 4.4rem;
  display: block;
  object-fit: cover;
  opacity: 0.72;
  filter: saturate(0.95) brightness(0.82);
  transition:
    opacity 160ms ease,
    filter 160ms ease;
}

.case-preview-gallery button.active img,
.case-preview-gallery button:hover img {
  opacity: 0.96;
  filter: saturate(1.05) brightness(0.98);
}

.case-preview-gallery span {
  position: absolute;
  left: 0.45rem;
  bottom: 0.38rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.24);
  border-radius: 999px;
  padding: 0.16rem 0.38rem;
  color: var(--pulse-main);
  background: rgba(0, 0, 0, 0.56);
  font-size: 0.62rem;
  font-weight: 950;
  letter-spacing: 0.04em;
  transition:
    color 4.5s ease,
    border-color 4.5s ease;
}

@media (max-width: 760px) {
  .case-preview-gallery {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}


/* CES-BUILD-034: Case Gallery Controls
   Ziel:
   - Galerie-Thumbnails liegen nicht mehr mitten auf dem großen Bild.
   - Großbild bekommt links/rechts Navigationspfeile.
   - Thumbnail-Leiste wird als ausfahrende Dock-Leiste unten im Bild platziert.
   - Keine Änderungen an CaseCube, Hero, WebCube, Services, CoreHub, MatrixRain oder ServiceFlow.
*/

.case-preview-image-wrap {
  position: relative;
  overflow: hidden;
}

/* BUILD-033 Galerie als Dock überschreiben */
.case-preview-gallery.case-preview-gallery-dock {
  position: absolute;
  left: clamp(0.75rem, 1.4vw, 1.2rem);
  right: clamp(0.75rem, 1.4vw, 1.2rem);
  bottom: 0.78rem;
  z-index: 5;
  display: block;
  border: 1px solid rgba(var(--pulse-rgb), 0.16);
  border-radius: 1rem;
  padding: 0.45rem 0.55rem 0.58rem;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018)),
    rgba(0, 0, 0, 0.68);
  backdrop-filter: blur(16px);
  box-shadow:
    0 18px 55px rgba(0, 0, 0, 0.42),
    0 0 34px rgba(var(--pulse-rgb), 0.08);
  transform: translateY(calc(100% - 2.05rem));
  opacity: 0.72;
  transition:
    transform 220ms ease,
    opacity 180ms ease,
    border-color 4.5s ease,
    box-shadow 4.5s ease,
    background 4.5s ease;
}

.case-preview-gallery.case-preview-gallery-dock:hover,
.case-preview-image-wrap:hover .case-preview-gallery.case-preview-gallery-dock {
  transform: translateY(0);
  opacity: 1;
}

.case-gallery-handle {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 1.38rem;
  color: var(--pulse-main);
  font-size: 0.68rem;
  font-weight: 950;
  letter-spacing: 0.11em;
  text-transform: uppercase;
  transition: color 4.5s ease;
}

.case-gallery-handle::before,
.case-gallery-handle::after {
  content: "";
  width: 3.4rem;
  height: 1px;
  margin: 0 0.7rem;
  background: linear-gradient(90deg, transparent, rgba(var(--pulse-rgb), 0.42), transparent);
  transition: background 4.5s ease;
}

.case-gallery-track {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.58rem;
  margin-top: 0.4rem;
}

.case-preview-gallery.case-preview-gallery-dock button {
  min-height: 4.75rem;
  max-height: 6.1rem;
}

.case-preview-gallery.case-preview-gallery-dock img {
  min-height: 4.75rem;
}

/* Pfeile links/rechts im großen Bild */
.case-preview-arrow {
  position: absolute;
  top: 50%;
  z-index: 6;
  display: grid;
  place-items: center;
  width: clamp(2.3rem, 3vw, 3.05rem);
  height: clamp(2.3rem, 3vw, 3.05rem);
  border: 1px solid rgba(var(--pulse-rgb), 0.22);
  border-radius: 999px;
  color: var(--pulse-main);
  background:
    radial-gradient(circle at 35% 25%, rgba(var(--pulse-next-rgb), 0.16), transparent 55%),
    rgba(0, 0, 0, 0.54);
  backdrop-filter: blur(12px);
  box-shadow:
    0 16px 42px rgba(0, 0, 0, 0.36),
    0 0 22px rgba(var(--pulse-rgb), 0.1);
  cursor: pointer;
  font-size: clamp(2rem, 3vw, 2.55rem);
  line-height: 1;
  transform: translateY(-50%);
  opacity: 0.78;
  transition:
    opacity 160ms ease,
    transform 160ms ease,
    color 4.5s ease,
    border-color 4.5s ease,
    background 4.5s ease,
    box-shadow 4.5s ease;
}

.case-preview-arrow:hover {
  opacity: 1;
  transform: translateY(-50%) scale(1.045);
  border-color: rgba(var(--pulse-rgb), 0.42);
  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.4),
    0 0 30px rgba(var(--pulse-rgb), 0.18);
}

.case-preview-arrow-left {
  left: clamp(1rem, 2vw, 1.6rem);
}

.case-preview-arrow-right {
  right: clamp(1rem, 2vw, 1.6rem);
}

.case-preview-counter {
  position: absolute;
  top: clamp(1rem, 1.8vw, 1.35rem);
  right: clamp(1rem, 1.8vw, 1.35rem);
  z-index: 6;
  border: 1px solid rgba(var(--pulse-rgb), 0.18);
  border-radius: 999px;
  padding: 0.32rem 0.62rem;
  color: var(--pulse-main);
  background: rgba(0, 0, 0, 0.56);
  backdrop-filter: blur(10px);
  font-size: 0.72rem;
  font-weight: 950;
  letter-spacing: 0.08em;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.32);
  transition:
    color 4.5s ease,
    border-color 4.5s ease;
}

/* Großbild bekommt unten genug optische Luft, wenn Dock eingefahren ist. */
.case-preview-image-wrap img {
  position: relative;
  z-index: 1;
}

/* Modal darf nicht zu viel Höhe verlieren, weil die Galerie jetzt im Bild dockt. */
.case-preview-modal {
  grid-template-rows: auto minmax(0, 1fr) auto;
}

@media (max-width: 760px) {
  .case-preview-gallery.case-preview-gallery-dock {
    transform: translateY(calc(100% - 2.1rem));
  }

  .case-gallery-track {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .case-preview-arrow {
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.85rem;
  }

  .case-preview-arrow-left {
    left: 0.55rem;
  }

  .case-preview-arrow-right {
    right: 0.55rem;
  }
}
