#root {
  min-height: 100vh;
}

:root {
  --bg: #020402;
  --bg-soft: #061006;
  --panel: rgba(7, 15, 8, 0.76);
  --panel-strong: rgba(8, 18, 9, 0.92);
  --line: rgba(113, 255, 23, 0.18);
  --line-strong: rgba(113, 255, 23, 0.42);
  --text: #f5fff0;
  --muted: #a6b5a0;
  --green: #76ff16;
  --green-soft: #b8ff7a;
  --green-deep: #245f0e;
  --cyan: #41d9ff;
  --red: #ff453a;
  --shadow: 0 30px 100px rgba(0, 0, 0, 0.58);
}

.app-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: var(--text);
  background:
    radial-gradient(circle at 18% 13%, rgba(255, 69, 58, 0.14), transparent 32rem),
    radial-gradient(circle at 83% 17%, rgba(65, 217, 255, 0.11), transparent 30rem),
    radial-gradient(circle at 44% 10%, rgba(118, 255, 22, 0.17), transparent 42rem),
    linear-gradient(135deg, #010201 0%, #071007 48%, #020302 100%);
}

.full-bleed-section,
.site-header {
  width: 100%;
  padding-left: clamp(1rem, 3.3vw, 4rem);
  padding-right: clamp(1rem, 3.3vw, 4rem);
}

.engine-grid {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.26;
  background-image:
    linear-gradient(rgba(118, 255, 22, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(118, 255, 22, 0.08) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(circle at center, #000 0%, transparent 82%);
}

.soft-scanlines {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.16;
  background: repeating-linear-gradient(
    180deg,
    transparent 0,
    transparent 7px,
    rgba(118, 255, 22, 0.05) 8px
  );
}

.ambient {
  position: fixed;
  pointer-events: none;
  filter: blur(42px);
  opacity: 0.72;
}

.ambient-green {
  width: 30rem;
  height: 30rem;
  left: 37%;
  top: -13rem;
  background: rgba(118, 255, 22, 0.19);
}

.ambient-red {
  width: 22rem;
  height: 22rem;
  left: -9rem;
  top: 12rem;
  background: rgba(255, 69, 58, 0.14);
}

.ambient-cyan {
  width: 24rem;
  height: 24rem;
  right: -9rem;
  top: 9rem;
  background: rgba(65, 217, 255, 0.12);
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding-top: 0.78rem;
  padding-bottom: 0.78rem;
  background: linear-gradient(180deg, rgba(2, 4, 2, 0.86), rgba(2, 4, 2, 0.33));
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(118, 255, 22, 0.1);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--text);
  text-decoration: none;
}

.brand img {
  width: 3.4rem;
  height: 3.4rem;
  object-fit: contain;
  filter: drop-shadow(0 0 18px rgba(118, 255, 22, 0.34));
}

.brand-text {
  display: grid;
  gap: 0.08rem;
}

.brand-text strong {
  font-size: 1rem;
  letter-spacing: -0.025em;
}

.brand-text small {
  color: var(--muted);
  font-size: 0.74rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.35rem;
  border: 1px solid rgba(118, 255, 22, 0.13);
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.34);
}

.main-nav a {
  color: var(--muted);
  text-decoration: none;
  font-size: 0.88rem;
  padding: 0.68rem 0.9rem;
  border-radius: 999px;
  transition: 180ms ease;
}

.main-nav a:hover {
  color: var(--text);
  background: rgba(118, 255, 22, 0.1);
}

.hero-section {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: minmax(34rem, 0.78fr) minmax(30rem, 1.22fr);
  gap: clamp(2rem, 4vw, 5rem);
  align-items: center;
  min-height: calc(100vh - 70px);
  padding-top: clamp(3rem, 5vw, 6rem);
  padding-bottom: clamp(3rem, 5vw, 6rem);
}

.eyebrow,
.section-heading span,
.showroom-copy span,
.reference-section span,
.contact-section span {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  width: fit-content;
  border: 1px solid rgba(118, 255, 22, 0.25);
  border-radius: 999px;
  padding: 0.5rem 0.78rem;
  color: var(--green);
  background: rgba(118, 255, 22, 0.1);
  box-shadow: inset 0 0 18px rgba(118, 255, 22, 0.08);
  font-size: 0.82rem;
  font-weight: 900;
  letter-spacing: -0.01em;
}

.hero-copy h1 {
  margin: 1.3rem 0 1.2rem;
  max-width: 780px;
  font-size: clamp(4rem, 7.45vw, 9.3rem);
  line-height: 0.875;
  letter-spacing: -0.09em;
}

.hero-copy h1 span {
  display: block;
  color: transparent;
  background: linear-gradient(90deg, #f5fff0, var(--green-soft), var(--green));
  -webkit-background-clip: text;
  background-clip: text;
  filter: drop-shadow(0 0 20px rgba(118, 255, 22, 0.15));
}

.hero-lead {
  max-width: 720px;
  margin: 0;
  color: #d9e7d3;
  font-size: clamp(1rem, 1.5vw, 1.24rem);
  line-height: 1.8;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  margin-top: 2rem;
}

.primary-action,
.secondary-action,
.ghost-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  min-height: 3.15rem;
  border-radius: 999px;
  padding: 0 1.2rem;
  font-weight: 900;
  text-decoration: none;
  transition: 180ms ease;
}

.primary-action {
  border: 1px solid rgba(184, 255, 122, 0.5);
  color: #061006;
  background: linear-gradient(135deg, var(--green-soft), var(--green));
  box-shadow: 0 18px 45px rgba(118, 255, 22, 0.22);
}

.primary-action:hover {
  transform: translateY(-2px);
  box-shadow: 0 22px 60px rgba(118, 255, 22, 0.33);
}

.secondary-action {
  border: 1px solid rgba(118, 255, 22, 0.36);
  color: var(--text);
  background: rgba(118, 255, 22, 0.08);
}

.secondary-action:hover,
.ghost-action:hover {
  transform: translateY(-2px);
  border-color: rgba(184, 255, 122, 0.5);
  background: rgba(118, 255, 22, 0.12);
}

.ghost-action {
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--muted);
  background: rgba(255, 255, 255, 0.03);
}

.hero-notes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  margin-top: 2rem;
  color: var(--muted);
  font-size: 0.9rem;
}

.hero-notes span {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.hero-notes svg {
  color: var(--green);
}

.hero-engine-stage {
  position: relative;
  min-height: 50rem;
  display: grid;
  place-items: center;
  isolation: isolate;
}

.hero-engine-stage::before {
  content: none;
}

.hero-orbit {
  display: none;
}

.core-logo-card {
  position: relative;
  display: grid;
  width: min(30vw, 29rem);
  min-width: 20rem;
  aspect-ratio: 1;
  place-items: center;
  border-radius: 2rem;
}

.core-logo-glow {
  position: absolute;
  width: 74%;
  height: 74%;
  border-radius: 50%;
  background: rgba(118, 255, 22, 0.24);
  filter: blur(46px);
}

.core-logo-card img {
  position: relative;
  z-index: 2;
  width: 100%;
  object-fit: contain;
  filter: drop-shadow(0 0 42px rgba(118, 255, 22, 0.36));
}

.command-panel,
.engine-module,
.launch-line {
  position: absolute;
  border: 1px solid rgba(118, 255, 22, 0.16);
  background: rgba(2, 8, 3, 0.76);
  backdrop-filter: blur(18px);
  box-shadow: 0 20px 70px rgba(0, 0, 0, 0.36);
}

.panel-main {
  left: 2%;
  top: 16%;
  width: 19.5rem;
  border-radius: 1.4rem;
  padding: 1.15rem;
}

.panel-kicker {
  display: block;
  color: var(--green);
  font-size: 0.75rem;
  font-weight: 900;
  letter-spacing: 0.08em;
  margin-bottom: 0.7rem;
}

.command-panel strong {
  display: block;
  color: var(--text);
  font-size: 1.2rem;
  margin-bottom: 0.45rem;
}

.command-panel p {
  margin: 0;
  color: var(--muted);
  line-height: 1.55;
  font-size: 0.92rem;
}

.engine-module {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  min-width: 12.3rem;
  border-radius: 1.1rem;
  padding: 0.85rem;
}

.engine-module svg,
.launch-line svg {
  color: var(--green);
}

.engine-module strong {
  display: block;
  font-size: 0.92rem;
}

.engine-module span {
  display: block;
  color: var(--muted);
  font-size: 0.78rem;
  margin-top: 0.12rem;
}

.module-1 {
  right: 5%;
  top: 18%;
}

.module-2 {
  left: 4%;
  bottom: 24%;
}

.module-3 {
  right: 2%;
  bottom: 28%;
}

.module-4 {
  right: 20%;
  bottom: 8%;
}

.launch-line {
  left: 50%;
  bottom: 3%;
  transform: translateX(-50%);
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  border-radius: 999px;
  padding: 0.78rem 1rem;
  color: var(--text);
  font-weight: 800;
}

.section-block,
.showroom-section,
.reference-section,
.contact-section {
  position: relative;
  z-index: 2;
  margin: 0 auto;
  padding-top: clamp(4rem, 6vw, 7rem);
  padding-bottom: clamp(4rem, 6vw, 7rem);
  border-top: 1px solid rgba(118, 255, 22, 0.08);
}

.section-heading {
  max-width: 880px;
  margin-bottom: 2rem;
}

.wide-heading {
  max-width: 1050px;
}

.section-heading h2,
.showroom-copy h2,
.reference-section h2,
.contact-section h2 {
  margin: 1rem 0 0.7rem;
  color: var(--text);
  font-size: clamp(2.4rem, 4.8vw, 5.2rem);
  line-height: 0.96;
  letter-spacing: -0.07em;
}

.section-heading p,
.showroom-copy p,
.reference-section p,
.contact-section p {
  margin: 0;
  color: var(--muted);
  font-size: 1.03rem;
  line-height: 1.75;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 1rem;
}

.service-card,
.theme-card,
.reference-grid article,
.hub-card,
.step-item {
  border: 1px solid rgba(118, 255, 22, 0.13);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent),
    var(--panel);
  box-shadow: var(--shadow);
  backdrop-filter: blur(18px);
}

.service-card {
  min-height: 15rem;
  border-radius: 1.45rem;
  padding: 1.25rem;
}

.card-icon,
.theme-icon {
  display: grid;
  place-items: center;
  width: 2.65rem;
  height: 2.65rem;
  border: 1px solid rgba(118, 255, 22, 0.25);
  border-radius: 0.9rem;
  color: var(--green);
  background: rgba(118, 255, 22, 0.08);
}

.service-card h3,
.theme-card h3,
.reference-grid h3,
.hub-card h3 {
  margin: 1.2rem 0 0.55rem;
  font-size: 1.08rem;
}

.service-card p,
.theme-card p,
.reference-grid p,
.hub-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.65;
  font-size: 0.95rem;
}

.showroom-section {
  display: grid;
  grid-template-columns: minmax(0, 0.68fr) minmax(420px, 1.32fr);
  gap: 2rem;
  align-items: center;
  min-height: 46rem;
  background:
    radial-gradient(circle at 71% 45%, rgba(118, 255, 22, 0.16), transparent 34rem),
    rgba(255, 255, 255, 0.012);
}

.showroom-note {
  margin-top: 1rem !important;
  border-left: 2px solid var(--green);
  padding-left: 1rem;
}

.hub-preview {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  perspective: 1000px;
}

.hub-card {
  min-height: 11rem;
  border-radius: 1.35rem;
  padding: 1.1rem;
  transform: translateZ(0);
  transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
}

.hub-card:hover {
  transform: translateY(-4px);
  border-color: rgba(118, 255, 22, 0.32);
  background:
    radial-gradient(circle at 45% 0%, rgba(118, 255, 22, 0.14), transparent 12rem),
    var(--panel);
}

.hub-card.active {
  border-color: rgba(118, 255, 22, 0.42);
  box-shadow: 0 25px 95px rgba(118, 255, 22, 0.12);
}

.hub-card span {
  color: var(--green);
  font-weight: 900;
  font-size: 0.78rem;
}

.hub-card h3 {
  font-size: 1.45rem;
  letter-spacing: -0.04em;
}

.theme-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.theme-card {
  border-radius: 1.45rem;
  padding: 1.2rem;
}

.theme-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.theme-head span {
  color: var(--muted);
  font-size: 0.75rem;
  text-align: right;
}

.theme-card strong {
  display: block;
  margin-bottom: 0.7rem;
  color: var(--green);
  font-size: 0.92rem;
}

.reference-section {
  display: grid;
  grid-template-columns: minmax(0, 0.66fr) minmax(0, 1.34fr);
  gap: 2rem;
  align-items: start;
}

.reference-grid {
  display: grid;
  gap: 1rem;
}

.reference-grid article {
  border-radius: 1.35rem;
  padding: 1.35rem;
}

.compact {
  padding-bottom: 4rem;
}

.steps-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.step-item {
  display: flex;
  gap: 1rem;
  align-items: center;
  border-radius: 1.2rem;
  padding: 1rem;
}

.step-item span {
  color: var(--green);
  font-weight: 900;
  font-size: 0.9rem;
}

.step-item p {
  margin: 0;
  color: #e7f4e1;
}

.contact-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  background:
    radial-gradient(circle at 14% 22%, rgba(118, 255, 22, 0.13), transparent 26rem),
    rgba(255, 255, 255, 0.016);
}

.site-footer {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin: 0 auto;
  padding-top: 2rem;
  padding-bottom: 2.4rem;
  color: var(--muted);
  font-size: 0.86rem;
  border-top: 1px solid rgba(118, 255, 22, 0.08);
}

@media (max-width: 1180px) {
  .hero-section,
  .showroom-section,
  .reference-section {
    grid-template-columns: 1fr;
  }

  .hero-copy h1 {
    max-width: 980px;
  }

  .hero-engine-stage {
    min-height: 36rem;
  }

  .service-grid,
  .theme-grid,
  .steps-list,
  .hub-preview {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .panel-main,
  .module-1,
  .module-2,
  .module-3,
  .module-4,
  .launch-line {
    position: static;
    transform: none;
  }

  .hero-engine-stage {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, auto));
    gap: 1rem;
  }

  .core-logo-card {
    grid-column: 1 / -1;
    justify-self: center;
  }
}

@media (max-width: 760px) {
  .main-nav {
    display: none;
  }

  .hero-section {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .hero-copy h1 {
    font-size: clamp(3.4rem, 16vw, 6.5rem);
  }

  .service-grid,
  .theme-grid,
  .steps-list,
  .hub-preview {
    grid-template-columns: 1fr;
  }

  .hero-engine-stage {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .core-logo-card {
    min-width: 16rem;
    width: min(78vw, 24rem);
  }

  .contact-section,
  .site-footer {
    flex-direction: column;
    align-items: stretch;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}


/* CES-BUILD-004: ShowcaseCube v2 integration */
.hero-showcase-cube {
  position: relative;
  z-index: 3;
  width: min(100%, 42rem);
  --cube-size: 360px;
  filter: drop-shadow(0 0 26px rgba(118, 255, 22, 0.16));
}

.hero-showcase-cube .showcase-cube {
  will-change: transform;
}

.hero-showcase-cube .showcase-cube-face {
  border-radius: 26px;
}

.hero-showcase-cube .face-screen {
  backdrop-filter: blur(10px);
}

@media (max-width: 1180px) {
  .hero-showcase-cube {
    grid-column: 1 / -1;
    justify-self: center;
    --cube-size: 320px;
  }
}

@media (max-width: 760px) {
  .hero-showcase-cube {
    --cube-size: 235px;
  }
}


/* CES-BUILD-005: Matrix background + Core orbit planets */
.matrix-rain-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0.23;
  mix-blend-mode: screen;
  mask-image:
    radial-gradient(circle at 74% 42%, #000 0%, rgba(0, 0, 0, 0.72) 28%, transparent 68%),
    linear-gradient(180deg, rgba(0,0,0,0.78), transparent 88%);
}

.core-orbit-system {
  position: absolute;
  inset: 0;
  z-index: 6;
  pointer-events: none;
  transform-style: preserve-3d;
}

.orbit-track {
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--orbit-w);
  height: var(--orbit-h);
  margin-left: calc(var(--orbit-w) / -2);
  margin-top: calc(var(--orbit-h) / -2);
  border: 1px solid rgba(118, 255, 22, 0.065);
  border-radius: 50%;
  transform: rotate(var(--orbit-tilt));
  animation: orbit-spin var(--orbit-speed) linear infinite;
  will-change: transform;
  pointer-events: none;
}

.orbit-track::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  border: 1px solid rgba(118, 255, 22, 0.035);
  filter: blur(0.5px);
}

.orbit-a {
  --orbit-w: min(50vw, 42rem);
  --orbit-h: min(25vw, 21rem);
  --orbit-speed: 28s;
  --orbit-tilt: -12deg;
}

.orbit-b {
  --orbit-w: min(56vw, 47rem);
  --orbit-h: min(31vw, 26rem);
  --orbit-speed: 38s;
  --orbit-tilt: 18deg;
  animation-direction: reverse;
}

.orbit-c {
  --orbit-w: min(45vw, 37rem);
  --orbit-h: min(34vw, 29rem);
  --orbit-speed: 33s;
  --orbit-tilt: 61deg;
}

.orbit-d {
  --orbit-w: min(60vw, 50rem);
  --orbit-h: min(25vw, 21rem);
  --orbit-speed: 45s;
  --orbit-tilt: -32deg;
  animation-direction: reverse;
}

.orbit-e {
  --orbit-w: min(39vw, 32rem);
  --orbit-h: min(39vw, 32rem);
  --orbit-speed: 24s;
  --orbit-tilt: 36deg;
}

.orbit-f {
  --orbit-w: min(57vw, 48rem);
  --orbit-h: min(42vw, 35rem);
  --orbit-speed: 52s;
  --orbit-tilt: -55deg;
  animation-direction: reverse;
}

.orbit-planet {
  position: absolute;
  left: calc(50% - var(--planet-size) / 2);
  top: calc(var(--planet-size) / -2);
  display: grid;
  place-items: center;
  width: var(--planet-size);
  height: var(--planet-size);
  border: 0;
  padding: 0;
  border-radius: 999px;
  background: transparent;
  cursor: pointer;
  pointer-events: auto;
  animation: planet-counter var(--orbit-speed) linear infinite;
  will-change: transform;
}

.orbit-b .orbit-planet,
.orbit-d .orbit-planet,
.orbit-f .orbit-planet {
  animation-direction: reverse;
}

.planet-surface {
  position: relative;
  display: grid;
  place-items: center;
  width: var(--planet-size);
  height: var(--planet-size);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 999px;
  color: rgba(255, 255, 255, 0.92);
  background:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.9), transparent 7%),
    radial-gradient(circle at 34% 30%, var(--planet-light), transparent 16%),
    radial-gradient(circle at 63% 70%, rgba(0, 0, 0, 0.55), transparent 44%),
    radial-gradient(circle at 42% 38%, var(--planet-main), var(--planet-dark) 72%);
  box-shadow:
    inset -10px -12px 18px rgba(0, 0, 0, 0.42),
    inset 8px 8px 18px rgba(255, 255, 255, 0.12),
    0 0 24px var(--planet-glow),
    0 0 58px rgba(118, 255, 22, 0.08);
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;
}

.planet-surface::before {
  content: "";
  position: absolute;
  inset: 9%;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(255,255,255,0.35), transparent 38%);
  opacity: 0.65;
}

.planet-surface svg {
  position: relative;
  z-index: 2;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));
}

.orbit-planet:hover .planet-surface {
  transform: scale(1.16);
  border-color: rgba(255, 255, 255, 0.36);
  box-shadow:
    inset -10px -12px 18px rgba(0, 0, 0, 0.42),
    inset 8px 8px 18px rgba(255, 255, 255, 0.14),
    0 0 34px var(--planet-glow),
    0 0 90px var(--planet-glow);
}

.planet-tooltip {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 0.75rem);
  width: max-content;
  max-width: 13rem;
  transform: translateX(-50%) translateY(8px);
  border: 1px solid rgba(118, 255, 22, 0.18);
  border-radius: 0.9rem;
  padding: 0.65rem 0.75rem;
  color: var(--text);
  background: rgba(2, 8, 3, 0.92);
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.42);
  opacity: 0;
  visibility: hidden;
  transition: 160ms ease;
  backdrop-filter: blur(16px);
  text-align: center;
}

.planet-tooltip strong {
  display: block;
  font-size: 0.86rem;
}

.planet-tooltip small {
  display: block;
  margin-top: 0.22rem;
  color: var(--muted);
  font-size: 0.72rem;
  line-height: 1.35;
}

.orbit-planet:hover .planet-tooltip {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

.planet-green {
  --planet-size: 3.15rem;
  --planet-main: #76ff16;
  --planet-dark: #185e08;
  --planet-light: #dbffb8;
  --planet-glow: rgba(118, 255, 22, 0.55);
}

.planet-cyan {
  --planet-size: 2.75rem;
  --planet-main: #40d9ff;
  --planet-dark: #08516a;
  --planet-light: #d6f7ff;
  --planet-glow: rgba(64, 217, 255, 0.44);
}

.planet-violet {
  --planet-size: 2.95rem;
  --planet-main: #8b5cff;
  --planet-dark: #29146e;
  --planet-light: #e0d5ff;
  --planet-glow: rgba(139, 92, 255, 0.45);
}

.planet-orange {
  --planet-size: 3rem;
  --planet-main: #ff9c32;
  --planet-dark: #853400;
  --planet-light: #ffe0b3;
  --planet-glow: rgba(255, 156, 50, 0.44);
}

.planet-silver {
  --planet-size: 2.55rem;
  --planet-main: #e7f2df;
  --planet-dark: #5f6d59;
  --planet-light: #ffffff;
  --planet-glow: rgba(231, 242, 223, 0.32);
}

.planet-red {
  --planet-size: 2.85rem;
  --planet-main: #ff453a;
  --planet-dark: #73100c;
  --planet-light: #ffd3d0;
  --planet-glow: rgba(255, 69, 58, 0.4);
}

.hero-showcase-cube {
  z-index: 4;
}

@keyframes orbit-spin {
  from {
    transform: rotate(var(--orbit-tilt)) rotate(0deg);
  }
  to {
    transform: rotate(var(--orbit-tilt)) rotate(360deg);
  }
}

@keyframes planet-counter {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(-360deg);
  }
}

.hero-engine-stage:hover .orbit-track {
  animation-play-state: paused;
}

.hero-engine-stage:hover .orbit-planet {
  animation-play-state: paused;
}

@media (max-width: 1180px) {
  .core-orbit-system {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .matrix-rain-canvas {
    display: none;
  }

  .orbit-track,
  .orbit-planet {
    animation: none !important;
  }
}


/* CES-BUILD-006: Free Orbit Hero Cleanup */
.hero-engine-stage {
  overflow: visible;
}

.hero-engine-stage::after {
  content: "";
  position: absolute;
  inset: 8% 3% 4%;
  z-index: -3;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 48%, rgba(118, 255, 22, 0.11), transparent 20rem),
    radial-gradient(circle at 64% 54%, rgba(65, 217, 255, 0.06), transparent 22rem);
  filter: blur(2px);
}

.core-orbit-system {
  overflow: visible;
}

/* Die kleinen Bahnen bleiben, aber der störende große Außenkreis aus den alten Hero-Orbits ist entfernt. */


/* CES-BUILD-007: Core Color Pulse */
.app-shell {
  --pulse-main: var(--green);
  --pulse-soft: var(--green-soft);
  --pulse-rgb: 118, 255, 22;
  --pulse-glow: rgba(var(--pulse-rgb), 0.28);
  transition:
    background 2.8s ease,
    color 2.8s ease;
}

.app-shell.tone-green {
  --green: #76ff16;
  --green-soft: #b8ff7a;
  --pulse-main: #76ff16;
  --pulse-soft: #b8ff7a;
  --pulse-rgb: 118, 255, 22;
  --pulse-glow: rgba(118, 255, 22, 0.3);
}

.app-shell.tone-cyan {
  --green: #41d9ff;
  --green-soft: #bff4ff;
  --pulse-main: #41d9ff;
  --pulse-soft: #bff4ff;
  --pulse-rgb: 65, 217, 255;
  --pulse-glow: rgba(65, 217, 255, 0.3);
}

.app-shell.tone-purple {
  --green: #b05cff;
  --green-soft: #dfc2ff;
  --pulse-main: #b05cff;
  --pulse-soft: #dfc2ff;
  --pulse-rgb: 176, 92, 255;
  --pulse-glow: rgba(176, 92, 255, 0.28);
}

.app-shell.tone-red {
  --green: #ff453a;
  --green-soft: #ffb1aa;
  --pulse-main: #ff453a;
  --pulse-soft: #ffb1aa;
  --pulse-rgb: 255, 69, 58;
  --pulse-glow: rgba(255, 69, 58, 0.28);
}

.app-shell.tone-green,
.app-shell.tone-cyan,
.app-shell.tone-purple,
.app-shell.tone-red {
  background:
    radial-gradient(circle at 18% 13%, rgba(255, 69, 58, 0.11), transparent 32rem),
    radial-gradient(circle at 83% 17%, rgba(65, 217, 255, 0.1), transparent 30rem),
    radial-gradient(circle at 44% 10%, var(--pulse-glow), transparent 42rem),
    linear-gradient(135deg, #010201 0%, #071007 48%, #020302 100%);
}

.engine-grid {
  transition: opacity 2.8s ease, background-image 2.8s ease;
  background-image:
    linear-gradient(rgba(var(--pulse-rgb), 0.075) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--pulse-rgb), 0.075) 1px, transparent 1px);
}

.site-header {
  transition: border-color 2.8s ease, background 2.8s ease;
  border-bottom-color: rgba(var(--pulse-rgb), 0.12);
}

.brand img {
  transition: filter 2.8s ease;
  filter: drop-shadow(0 0 18px rgba(var(--pulse-rgb), 0.34));
}

.core-logo-card img,
.hero-showcase-cube {
  transition: filter 2.8s ease;
}

.core-logo-card img {
  filter: drop-shadow(0 0 42px rgba(var(--pulse-rgb), 0.36));
}

.hero-showcase-cube {
  filter: drop-shadow(0 0 30px rgba(var(--pulse-rgb), 0.2));
}

.eyebrow,
.section-heading span,
.showroom-copy span,
.reference-section span,
.contact-section span {
  border-color: rgba(var(--pulse-rgb), 0.26);
  color: var(--pulse-main);
  background: rgba(var(--pulse-rgb), 0.1);
  box-shadow: inset 0 0 18px rgba(var(--pulse-rgb), 0.08);
  transition:
    color 2.8s ease,
    border-color 2.8s ease,
    background 2.8s ease,
    box-shadow 2.8s ease;
}

.hero-copy h1 span {
  background: linear-gradient(90deg, #f5fff0, var(--pulse-soft), var(--pulse-main));
  -webkit-background-clip: text;
  background-clip: text;
  filter: drop-shadow(0 0 20px rgba(var(--pulse-rgb), 0.15));
  transition: filter 2.8s ease;
}

.primary-action {
  border-color: rgba(var(--pulse-rgb), 0.5);
  background: linear-gradient(135deg, var(--pulse-soft), var(--pulse-main));
  box-shadow: 0 18px 45px rgba(var(--pulse-rgb), 0.22);
  transition:
    transform 180ms ease,
    box-shadow 2.8s ease,
    border-color 2.8s ease,
    background 2.8s ease;
}

.primary-action:hover {
  box-shadow: 0 22px 60px rgba(var(--pulse-rgb), 0.34);
}

.secondary-action {
  border-color: rgba(var(--pulse-rgb), 0.36);
  background: rgba(var(--pulse-rgb), 0.08);
}

.secondary-action:hover,
.ghost-action:hover {
  border-color: rgba(var(--pulse-rgb), 0.48);
  background: rgba(var(--pulse-rgb), 0.12);
}

.hero-notes svg,
.launch-line svg,
.card-icon,
.theme-icon,
.theme-card strong,
.step-item span,
.hub-card span,
.panel-kicker {
  color: var(--pulse-main);
  transition: color 2.8s ease, border-color 2.8s ease, background 2.8s ease;
}

.card-icon,
.theme-icon {
  border-color: rgba(var(--pulse-rgb), 0.25);
  background: rgba(var(--pulse-rgb), 0.08);
}

.service-card,
.theme-card,
.reference-grid article,
.hub-card,
.step-item {
  border-color: rgba(var(--pulse-rgb), 0.13);
  transition: border-color 2.8s ease, box-shadow 2.8s ease, background 2.8s ease, transform 180ms ease;
}

.hub-card:hover {
  border-color: rgba(var(--pulse-rgb), 0.32);
  background:
    radial-gradient(circle at 45% 0%, rgba(var(--pulse-rgb), 0.14), transparent 12rem),
    var(--panel);
}

.hub-card.active {
  border-color: rgba(var(--pulse-rgb), 0.42);
  box-shadow: 0 25px 95px rgba(var(--pulse-rgb), 0.12);
}

.section-block,
.showroom-section,
.reference-section,
.contact-section,
.site-footer {
  border-top-color: rgba(var(--pulse-rgb), 0.08);
  transition: border-color 2.8s ease, background 2.8s ease;
}

.showroom-section {
  background:
    radial-gradient(circle at 71% 45%, rgba(var(--pulse-rgb), 0.16), transparent 34rem),
    rgba(255, 255, 255, 0.012);
}

.showroom-note {
  border-left-color: var(--pulse-main);
  transition: border-color 2.8s ease;
}

.contact-section {
  background:
    radial-gradient(circle at 14% 22%, rgba(var(--pulse-rgb), 0.13), transparent 26rem),
    rgba(255, 255, 255, 0.016);
}

.hero-engine-stage::after {
  background:
    radial-gradient(circle at 50% 48%, rgba(var(--pulse-rgb), 0.12), transparent 20rem),
    radial-gradient(circle at 64% 54%, rgba(65, 217, 255, 0.045), transparent 22rem);
  transition: background 2.8s ease;
}

.orbit-track {
  border-color: rgba(var(--pulse-rgb), 0.07);
  transition: border-color 2.8s ease;
}

.orbit-track::before {
  border-color: rgba(var(--pulse-rgb), 0.04);
  transition: border-color 2.8s ease;
}

.planet-green {
  --planet-main: var(--pulse-main);
  --planet-dark: #185e08;
  --planet-light: var(--pulse-soft);
  --planet-glow: rgba(var(--pulse-rgb), 0.55);
}

@media (prefers-reduced-motion: reduce) {
  .app-shell {
    transition: none;
  }
}


/* CES-BUILD-008: Smooth Color Pulse refinement */
.app-shell {
  transition:
    background-color 4s ease,
    color 4s ease;
}

.app-shell::before,
.app-shell::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  transition:
    opacity 4s ease,
    background 4s ease;
}

.app-shell::before {
  opacity: 0.55;
  background:
    radial-gradient(circle at 44% 10%, rgba(var(--pulse-rgb), 0.18), transparent 42rem),
    radial-gradient(circle at 77% 28%, rgba(var(--pulse-rgb), 0.08), transparent 34rem);
}

.app-shell::after {
  opacity: 0.18;
  background:
    linear-gradient(120deg, transparent 0%, rgba(var(--pulse-rgb), 0.16) 48%, transparent 75%);
  mix-blend-mode: screen;
}

.engine-grid,
.site-header,
.brand img,
.core-logo-card img,
.hero-showcase-cube,
.eyebrow,
.section-heading span,
.showroom-copy span,
.reference-section span,
.contact-section span,
.hero-copy h1 span,
.primary-action,
.secondary-action,
.ghost-action,
.card-icon,
.theme-icon,
.service-card,
.theme-card,
.reference-grid article,
.hub-card,
.step-item,
.section-block,
.showroom-section,
.reference-section,
.contact-section,
.site-footer,
.showroom-note,
.hero-engine-stage::after,
.orbit-track,
.orbit-track::before {
  transition-duration: 4s !important;
}

.matrix-rain-canvas {
  transition: opacity 4s ease, filter 4s ease;
}


/* CES-BUILD-009: Anthracite Pulse Background Cleanup
   Entfernt feste rote/cyan Lichtquellen und macht den Hintergrund ruhiger.
*/
.app-shell {
  background:
    radial-gradient(circle at 68% 42%, rgba(var(--pulse-rgb), 0.16), transparent 34rem),
    radial-gradient(circle at 43% 14%, rgba(var(--pulse-rgb), 0.09), transparent 42rem),
    linear-gradient(135deg, #050706 0%, #090d0a 42%, #030403 100%) !important;
}

.app-shell.tone-green,
.app-shell.tone-cyan,
.app-shell.tone-purple,
.app-shell.tone-red {
  background:
    radial-gradient(circle at 68% 42%, rgba(var(--pulse-rgb), 0.16), transparent 34rem),
    radial-gradient(circle at 43% 14%, rgba(var(--pulse-rgb), 0.09), transparent 42rem),
    linear-gradient(135deg, #050706 0%, #090d0a 42%, #030403 100%) !important;
}

/* Alte statische Lichtquellen aus früheren Builds deaktivieren */
.ambient-red,
.ambient-cyan {
  display: none !important;
}

.ambient-green {
  background: rgba(var(--pulse-rgb), 0.13) !important;
  opacity: 0.48 !important;
  transition: background 4s ease, opacity 4s ease;
}

/* Die zusätzlichen Smooth-Pulse-Overlays bleiben, aber ohne harte Lichtflächen */
.app-shell::before {
  opacity: 0.34 !important;
  background:
    radial-gradient(circle at 62% 43%, rgba(var(--pulse-rgb), 0.13), transparent 30rem),
    radial-gradient(circle at 48% 16%, rgba(var(--pulse-rgb), 0.07), transparent 36rem) !important;
}

.app-shell::after {
  opacity: 0.07 !important;
  background:
    linear-gradient(120deg, transparent 0%, rgba(var(--pulse-rgb), 0.11) 50%, transparent 78%) !important;
}

/* Sektionen bekommen keinen eigenen farbigen Fremdglow mehr */
.showroom-section,
.contact-section {
  background:
    radial-gradient(circle at 70% 45%, rgba(var(--pulse-rgb), 0.08), transparent 30rem),
    rgba(255, 255, 255, 0.008) !important;
}

.hero-engine-stage::after {
  background:
    radial-gradient(circle at 50% 48%, rgba(var(--pulse-rgb), 0.09), transparent 20rem) !important;
}

/* Matrix bleibt sichtbar, aber die farbigen Hintergrundfelder werden ruhiger */
.matrix-rain-canvas {
  opacity: 0.2 !important;
}

/* Grid etwas neutraler, damit die Pulse-Farbe nicht als harte Fläche wirkt */
.engine-grid {
  opacity: 0.22 !important;
  background-image:
    linear-gradient(rgba(var(--pulse-rgb), 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--pulse-rgb), 0.055) 1px, transparent 1px) !important;
}


/* CES-BUILD-010: Cube Only Hero
   Entfernt Planeten, Orbitbahnen und Orbit-Label im Hero.
*/
.core-orbit-system,
.orbit-track,
.orbit-planet,
.launch-line,
.hero-orbit {
  display: none !important;
}

.hero-engine-stage {
  min-height: 48rem;
  display: grid;
  place-items: center;
}

.hero-showcase-cube {
  width: min(100%, 46rem);
  filter:
    drop-shadow(0 0 28px rgba(var(--pulse-rgb), 0.22))
    drop-shadow(0 0 75px rgba(var(--pulse-rgb), 0.12));
}

.hero-engine-stage::after {
  background:
    radial-gradient(circle at 50% 48%, rgba(var(--pulse-rgb), 0.11), transparent 21rem),
    radial-gradient(circle at 50% 52%, rgba(255, 255, 255, 0.025), transparent 32rem) !important;
}


/* CES-BUILD-011: Premium Hero Composition */
.hero-section {
  grid-template-columns: minmax(30rem, 0.72fr) minmax(34rem, 1.28fr);
  gap: clamp(2.5rem, 5vw, 7rem);
  align-items: center;
  padding-top: clamp(2.8rem, 4.5vw, 5.4rem);
  padding-bottom: clamp(3.2rem, 5vw, 6rem);
}

.premium-hero-copy {
  max-width: 760px;
  padding-left: clamp(0rem, 1vw, 1.25rem);
}

.hero-brandline {
  display: grid;
  gap: 0.42rem;
  margin-top: 1.35rem;
  margin-bottom: 1.1rem;
}

.hero-brandline span {
  color: var(--pulse-main);
  font-size: clamp(1.1rem, 1.4vw, 1.45rem);
  font-weight: 900;
  letter-spacing: -0.035em;
  text-shadow: 0 0 20px rgba(var(--pulse-rgb), 0.22);
  transition: color 4s ease, text-shadow 4s ease;
}

.hero-brandline strong {
  max-width: 42rem;
  color: rgba(245, 255, 240, 0.78);
  font-size: clamp(0.9rem, 1.1vw, 1.08rem);
  font-weight: 700;
  line-height: 1.45;
  letter-spacing: 0.01em;
}

.premium-hero-copy h1 {
  max-width: 780px;
  margin: 0 0 1.15rem;
  font-size: clamp(3.4rem, 5.9vw, 7.2rem);
  line-height: 0.92;
  letter-spacing: -0.085em;
}

.premium-hero-copy h1 span {
  display: block;
  margin-top: 0.12em;
}

.premium-hero-copy .hero-lead {
  max-width: 700px;
  color: rgba(230, 244, 224, 0.84);
  font-size: clamp(1rem, 1.25vw, 1.16rem);
}

.hero-module-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.85rem;
  margin-top: 2.1rem;
  max-width: 760px;
}

.hero-module-strip article {
  position: relative;
  min-height: 7.4rem;
  border: 1px solid rgba(var(--pulse-rgb), 0.14);
  border-radius: 1.25rem;
  padding: 1rem;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 0%, rgba(var(--pulse-rgb), 0.12), transparent 9rem),
    rgba(7, 15, 8, 0.62);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(16px);
  transition: border-color 4s ease, background 4s ease, box-shadow 4s ease, transform 180ms ease;
}

.hero-module-strip article:hover {
  transform: translateY(-3px);
  border-color: rgba(var(--pulse-rgb), 0.28);
  box-shadow: 0 22px 70px rgba(var(--pulse-rgb), 0.09);
}

.hero-module-strip span {
  display: inline-flex;
  margin-bottom: 0.72rem;
  color: var(--pulse-main);
  font-size: 0.78rem;
  font-weight: 950;
  transition: color 4s ease;
}

.hero-module-strip strong {
  display: block;
  color: var(--text);
  font-size: 1rem;
  letter-spacing: -0.03em;
}

.hero-module-strip small {
  display: block;
  margin-top: 0.42rem;
  color: var(--muted);
  font-size: 0.78rem;
  line-height: 1.45;
}

.hero-engine-stage {
  min-height: 49rem;
  justify-items: center;
  align-items: center;
}

.hero-showcase-cube {
  transform: translateX(-1vw);
}

@media (max-width: 1180px) {
  .hero-section {
    grid-template-columns: 1fr;
  }

  .premium-hero-copy {
    max-width: 980px;
  }

  .premium-hero-copy h1 {
    max-width: 930px;
  }

  .hero-showcase-cube {
    transform: none;
  }
}

@media (max-width: 760px) {
  .premium-hero-copy h1 {
    font-size: clamp(3.05rem, 14vw, 5.6rem);
  }

  .hero-module-strip {
    grid-template-columns: 1fr;
  }
}


/* CES-BUILD-012: Hero Width + Typography Fix
   Ziel: Farbverlauf bleibt, aber die Headline wird kleiner, breiter und wirkt nicht mehr gekappt/gequetscht.
*/
.hero-section {
  grid-template-columns: minmax(42rem, 0.96fr) minmax(31rem, 1.04fr);
  gap: clamp(2rem, 3.6vw, 5rem);
}

.premium-hero-copy {
  max-width: min(60rem, 100%);
  padding-left: clamp(0.25rem, 0.8vw, 1rem);
}

.premium-hero-copy h1 {
  max-width: 60rem;
  width: 100%;
  font-size: clamp(3.15rem, 4.85vw, 5.95rem);
  line-height: 1.02;
  letter-spacing: -0.065em;
  margin-bottom: 1.25rem;
  overflow: visible;
  text-wrap: balance;
}

.premium-hero-copy h1 span {
  display: block;
  margin-top: 0.08em;
  white-space: nowrap;
}

.premium-hero-copy .hero-lead {
  max-width: 48rem;
}

.hero-module-strip {
  max-width: 48rem;
}

.hero-actions {
  margin-top: 1.75rem;
}

.hero-engine-stage {
  min-height: 48rem;
}

.hero-showcase-cube {
  transform: translateX(0);
  width: min(100%, 44rem);
}

/* Bei mittleren Breiten darf die Schrift umbrechen, aber nicht gedrückt wirken. */
@media (max-width: 1320px) {
  .hero-section {
    grid-template-columns: minmax(34rem, 0.9fr) minmax(29rem, 1.1fr);
  }

  .premium-hero-copy h1 {
    font-size: clamp(3rem, 4.6vw, 5.2rem);
    max-width: 52rem;
  }
}

@media (max-width: 1180px) {
  .hero-section {
    grid-template-columns: 1fr;
  }

  .premium-hero-copy {
    max-width: 100%;
  }

  .premium-hero-copy h1 {
    max-width: 58rem;
  }

  .premium-hero-copy h1 span {
    white-space: normal;
  }
}

@media (max-width: 760px) {
  .premium-hero-copy h1 {
    font-size: clamp(2.55rem, 11vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .premium-hero-copy h1 span {
    white-space: normal;
  }
}


/* CES-BUILD-013: Engine Descender Fix
   Fix: Das "g" in Engine darf nicht mehr optisch abgeschnitten/gequetscht wirken.
*/
.premium-hero-copy h1 {
  line-height: 1.08;
  padding-bottom: 0.16em;
  margin-bottom: 1.05rem;
  overflow: visible;
}

.premium-hero-copy h1 span {
  line-height: 1.08;
  padding-bottom: 0.08em;
  overflow: visible;
}

.hero-section,
.premium-hero-copy {
  overflow: visible;
}

@media (max-width: 760px) {
  .premium-hero-copy h1 {
    line-height: 1.06;
    padding-bottom: 0.18em;
  }
}


/* CES-BUILD-014: Smooth Pulse + Descender Fix
   1) Farbwechsel läuft jetzt über weich interpolierte CSS-Variablen per JS.
   2) Das "g" in Engine bekommt deutlich mehr Unterlänge-Luft.
*/
.hero-section,
.premium-hero-copy,
.premium-hero-copy h1,
.premium-hero-copy h1 span {
  overflow: visible !important;
}

.premium-hero-copy h1 {
  line-height: 1.14 !important;
  padding-bottom: 0.34em !important;
  margin-bottom: 0.65rem !important;
}

.premium-hero-copy h1 span {
  display: inline-block !important;
  line-height: 1.14 !important;
  padding-bottom: 0.32em !important;
  overflow: visible !important;
}

/* Die großen Farbflächen folgen jetzt nur noch den weich interpolierten Variablen. */
.app-shell {
  background:
    radial-gradient(circle at 68% 42%, rgba(var(--pulse-rgb), 0.14), transparent 34rem),
    radial-gradient(circle at 43% 14%, rgba(var(--pulse-rgb), 0.075), transparent 42rem),
    linear-gradient(135deg, #050706 0%, #090d0a 42%, #030403 100%) !important;
}

/* Keine harten Tone-Klassen mehr: diese Selektoren bleiben nur als Fallback neutral. */
.app-shell.tone-green,
.app-shell.tone-cyan,
.app-shell.tone-purple,
.app-shell.tone-red {
  background:
    radial-gradient(circle at 68% 42%, rgba(var(--pulse-rgb), 0.14), transparent 34rem),
    radial-gradient(circle at 43% 14%, rgba(var(--pulse-rgb), 0.075), transparent 42rem),
    linear-gradient(135deg, #050706 0%, #090d0a 42%, #030403 100%) !important;
}

.hero-copy h1 span,
.primary-action,
.secondary-action,
.ghost-action,
.eyebrow,
.section-heading span,
.showroom-copy span,
.reference-section span,
.contact-section span,
.engine-grid,
.hero-showcase-cube,
.card-icon,
.theme-icon,
.service-card,
.theme-card,
.reference-grid article,
.hub-card,
.step-item {
  transition-duration: 4.5s !important;
}

@media (max-width: 760px) {
  .premium-hero-copy h1 {
    line-height: 1.12 !important;
    padding-bottom: 0.38em !important;
  }

  .premium-hero-copy h1 span {
    padding-bottom: 0.36em !important;
  }
}
